                        <h6 class="mb-3">Supported Providers:</h6>
                        <ul class="provider-list">
                            <li>LIC (Life Insurance Corporation)</li>
                            <li>HDFC Life Insurance</li>
                            <li>ICICI Prudential Life</li>
                            <li>SBI Life Insurance</li>
                            <li>Max Life Insurance</li>
                            <li>Bajaj Allianz Life</li>
                            <li>Tata AIA Life Insurance</li>
                            <li>Kotak Life Insurance</li>
                        </ul>
                    </div>
                </div>

                <!-- Health Insurance -->
                <div class="col-lg-4 col-md-6">
                    <div class="insurance-category-card p-4 health-insurance">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-hospital category-icon" style="color: var(--health-color);"></i>
                            <h4 class="mb-0 ms-3">Health Insurance</h4>
                        </div>
                        <p class="text-muted">Renew your health insurance policies from top providers across India</p>
                        <h6 class="mb-3">Supported Providers:</h6>
                        <ul class="provider-list">
                            <li>Star Health Insurance</li>
                            <li>Care Health Insurance</li>
                            <li>Religare Health Insurance</li>
                            <li>Max Bupa Health</li>
                            <li>Niva Bupa Health</li>
                            <li>ICICI Lombard Health</li>
                            <li>Aditya Birla Health</li>
                            <li>Manipal Cigna Health</li>
                        </ul>
                    </div>
                </div>

                <!-- Motor Insurance -->
                <div class="col-lg-4 col-md-6">
                    <div class="insurance-category-card p-4 motor-insurance">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-car category-icon" style="color: var(--motor-color);"></i>
                            <h4 class="mb-0 ms-3">Motor Insurance</h4>
                        </div>
                        <p class="text-muted">Pay premiums for car, bike, and commercial vehicle insurance policies</p>
                        <h6 class="mb-3">Supported Providers:</h6>
                        <ul class="provider-list">
                            <li>Bajaj Allianz General</li>
                            <li>ICICI Lombard</li>
                            <li>HDFC ERGO</li>
                            <li>Reliance General</li>
                            <li>Tata AIG</li>
                            <li>Royal Sundaram</li>
                            <li>New India Assurance</li>
                            <li>National Insurance</li>
                        </ul>
                    </div>
                </div>

                <!-- Home Insurance -->
                <div class="col-lg-4 col-md-6">
                    <div class="insurance-category-card p-4 home-insurance">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-home category-icon" style="color: var(--home-color);"></i>
                            <h4 class="mb-0 ms-3">Home Insurance</h4>
                        </div>
                        <p class="text-muted">Secure your home with insurance from trusted providers</p>
                        <h6 class="mb-3">Supported Providers:</h6>
                        <ul class="provider-list">
                            <li>HDFC ERGO Home Shield</li>
                            <li>ICICI Lombard Home</li>
                            <li>Bajaj Allianz Home</li>
                            <li>Reliance Home Insurance</li>
                            <li>Tata AIG Home</li>
                            <li>Royal Sundaram Home</li>
                            <li>Oriental Insurance Home</li>
                            <li>United India Home</li>
                        </ul>
                    </div>
                </div>

                <!-- Travel Insurance -->
                <div class="col-lg-4 col-md-6">
                    <div class="insurance-category-card p-4 travel-insurance">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-plane category-icon" style="color: var(--travel-color);"></i>
                            <h4 class="mb-0 ms-3">Travel Insurance</h4>
                        </div>
                        <p class="text-muted">Pay for domestic and international travel insurance policies</p>
                        <h6 class="mb-3">Supported Providers:</h6>
                        <ul class="provider-list">
                            <li>ICICI Lombard Travel</li>
                            <li>HDFC ERGO Travel</li>
                            <li>Bajaj Allianz Travel</li>
                            <li>Reliance Travel Insurance</li>
                            <li>Tata AIG Travel</li>
                            <li>Care Travel Insurance</li>
                            <li>Digit Travel Insurance</li>
                            <li>Go Digit Travel</li>
                        </ul>
                    </div>
                </div>

                <!-- General Insurance -->
                <div class="col-lg-4 col-md-6">
                    <div class="insurance-category-card p-4 general-insurance">
                        <div class="d-flex align-items-center mb-3">
                            <i class="fas fa-briefcase category-icon" style="color: var(--general-color);"></i>
                            <h4 class="mb-0 ms-3">General Insurance</h4>
                        </div>
                        <p class="text-muted">Various other insurance categories for comprehensive coverage</p>
                        <h6 class="mb-3">Supported Categories:</h6>
                        <ul class="provider-list">
                            <li>Personal Accident Insurance</li>
                            <li>Fire Insurance</li>
                            <li>Marine Insurance</li>
                            <li>Liability Insurance</li>
                            <li>Crop Insurance</li>
                            <li>Business Insurance</li>
                            <li>Cyber Insurance</li>
                            <li>Equipment Insurance</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment Features Section -->
        <div class="mb-5">
            <h2 class="section-title">Payment Features</h2>
            <p class="mb-4">Experience seamless and secure insurance premium payments with our advanced features.</p>

            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <h5>Instant Processing</h5>
                        <p class="text-muted">Your insurance premium is processed immediately with real-time confirmation</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <h5>Email & SMS Alerts</h5>
                        <p class="text-muted">Receive instant payment confirmation via email and SMS for your records</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <h5>Multiple Payment Options</h5>
                        <p class="text-muted">Pay using UPI, debit card, credit card, net banking</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                        <h5>Mobile Friendly</h5>
                        <p class="text-muted">Pay your insurance bills anytime, anywhere from your mobile device</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <h5>Auto-Pay Setup</h5>
                        <p class="text-muted">Set up automatic payments to never miss a premium due date</p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="fas fa-history"></i>
                        </div>
                        <h5>Payment History</h5>
                        <p class="text-muted">Access complete payment history and download receipts anytime</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- How to Pay Section -->
        <div class="mb-5">
            <h2 class="section-title">How to Pay Insurance Bills</h2>
            <p class="mb-4">Follow these simple steps to pay your insurance premiums securely through Payman.</p>

            <div class="process-timeline">
                <!-- Step 1 -->
                <div class="process-step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h5>Login to Portal</h5>
                        <p>Access your Payman Insurance account using your registered mobile number and credentials</p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="process-step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h5>Select Insurance Category</h5>
                        <p>Choose from Life, Health, Motor, Home, Travel, or General Insurance category</p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="process-step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h5>Enter Policy Details</h5>
                        <p>Provide your insurance policy number and verify the premium amount to be paid</p>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="process-step">
                    <div class="step-number">4</div>
                    <div class="step-content">
                        <h5>Make Secure Payment</h5>
                        <p>Complete payment using your preferred payment method through our secure gateway</p>
                    </div>
                </div>

                <!-- Step 5 -->
                <div class="process-step">
                    <div class="step-number">5</div>
                    <div class="step-content">
                        <h5>Get Confirmation</h5>
                        <p>Receive instant payment confirmation via SMS, email, and on-screen notification</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <div class="cta-section">
            <h2 class="mb-3">Ready to Pay Your Insurance Premium?</h2>
            <p class="mb-4" style="font-size: 1.1rem;">Login now to access all insurance payment services through BBPS</p>
            <button class="cta-btn" id="payNowBtn">
                <i class="fas fa-credit-card cta-icon"></i>Pay Now
            </button>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>Insurance by Payman</h5>
                    <p>Secure insurance premium payment facilitation platform.</p>
                    <p class="mb-1">Pay premiums for all types of insurance policies through BBPS</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1">&copy; 2026 Payman Fintech Solutions Private Limited. All rights reserved.</p>
                    <p class="mb-0">Operated under RBI guidelines and regulations.</p>
                    <div class="mt-3">
                        <a asp-controller="Insurance" asp-action="Terms" class="text-white me-3">Terms & Conditions</a>
                        <a asp-controller="Insurance" asp-action="Privacy" class="text-white me-3">Privacy Policy</a>
                        <a asp-controller="Insurance" asp-action="RefundPolcy" class="text-white me-3">Refund Policy</a>
                        <a asp-controller="Insurance" asp-action="ContactUs" class="text-white">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


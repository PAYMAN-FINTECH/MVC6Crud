        <div class="container">
            <h1>Our Insurance Services</h1>
            <p class="subtitle">Pay premiums for all types of insurance policies through BBPS</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <!-- Insurance Categories Section -->
        <div class="mb-5">
            <h2 class="section-title">Insurance Categories</h2>
            <p class="mb-4">We support premium payments for all major insurance providers across various categories.</p>

            <div class="row g-4">

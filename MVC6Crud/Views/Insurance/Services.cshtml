@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Insurence.cshtml";
}

@{
    ViewData["Title"] = "Insurance List - Payman Insurance";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Insurance Services - Insurance Premium Payments by Payman</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --info-color: #17a2b8;
            --light-bg: #f8f9fa;
            --dark-color: #343a40;
            --life-color: #e83e8c;
            --health-color: #20c997;
            --motor-color: #6f42c1;
            --home-color: #fd7e14;
            --travel-color: #17a2b8;
            --general-color: #6610f2;
        }

        body {
            font-family: 'Roboto', sans-serif;
            color: #333;
            line-height: 1.6;
            padding-top: 76px; /* Account for fixed navbar */
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
        }

        .page-header {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            padding: 60px 0 40px;
            margin-bottom: 40px;
        }

            .page-header h1 {
                font-size: 2.8rem;
                margin-bottom: 10px;
            }

            .page-header .subtitle {
                font-size: 1.2rem;
                opacity: 0.9;
                font-weight: 300;
            }

        .section-title {
            color: var(--primary-color);
            border-bottom: 2px solid #eaeaea;
            padding-bottom: 10px;
            margin-bottom: 30px;
            position: relative;
        }

            .section-title:after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -2px;
                width: 80px;
                height: 2px;
                background-color: var(--primary-color);
            }

        .insurance-category-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            overflow: hidden;
        }

            .insurance-category-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            }

        .category-icon {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .life-insurance {
            border-top: 4px solid var(--life-color);
        }

        .health-insurance {
            border-top: 4px solid var(--health-color);
        }

        .motor-insurance {
            border-top: 4px solid var(--motor-color);
        }

        .home-insurance {
            border-top: 4px solid var(--home-color);
        }

        .travel-insurance {
            border-top: 4px solid var(--travel-color);
        }

        .general-insurance {
            border-top: 4px solid var(--general-color);
        }

        .provider-list {
            list-style: none;
            padding: 0;
            margin: 0;
            column-count: 2;
            column-gap: 20px;
        }

            .provider-list li {
                padding: 5px 0;
                padding-left: 20px;
                position: relative;
                break-inside: avoid;
            }

                .provider-list li:before {
                    content: '✓';
                    position: absolute;
                    left: 0;
                    color: var(--success-color);
                    font-weight: bold;
                }

        .feature-card {
            text-align: center;
            padding: 25px 15px;
            border-radius: 10px;
            background: white;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            height: 100%;
        }

            .feature-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .feature-icon {
            font-size: 2.2rem;
            color: var(--primary-color);
            margin-bottom: 15px;
            width: 70px;
            height: 70px;
            background: rgba(0, 123, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .process-timeline {
            position: relative;
            padding: 40px 0;
        }

            .process-timeline:before {
                content: '';
                position: absolute;
                left: 50%;
                top: 0;
                bottom: 0;
                width: 3px;
                background: var(--primary-color);
                transform: translateX(-50%);
            }

        .process-step {
            position: relative;
            margin-bottom: 50px;
            width: 50%;
            padding: 0 40px;
        }

            .process-step:nth-child(odd) {
                left: 0;
                text-align: right;
            }

            .process-step:nth-child(even) {
                left: 50%;
                text-align: left;
            }

        .step-number {
            width: 50px;
            height: 50px;
            background: var(--primary-color);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
            position: absolute;
            top: 0;
        }

        .process-step:nth-child(odd) .step-number {
            right: -25px;
        }

        .process-step:nth-child(even) .step-number {
            left: -25px;
        }

        .step-content {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .cta-section {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            padding: 50px;
            text-align: center;
            margin: 60px 0;
        }

        .cta-btn {
            background: linear-gradient(135deg, var(--primary-color) 0%, #0056b3 100%);
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .cta-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(0, 123, 255, 0.3);
                color: white;
            }

        .cta-icon {
            margin-right: 10px;
            font-size: 1.5rem;
        }

       

            .process-step {
                width: 100%;
                left: 0 !important;
                text-align: left !important;
                padding-left: 80px;
                padding-right: 20px;
            }

                .process-step:nth-child(odd) .step-number,
                .process-step:nth-child(even) .step-number {
                    left: 5px;
                    right: auto;
                }

            .provider-list {
                column-count: 1;
            }
        }

       
                .page-header h1 {
                    font-size: 2.2rem;
                }

            .cta-section {
                padding: 30px 20px;
            }
        }
    </style>
</head>
<body>
    
    <!-- Page Header -->

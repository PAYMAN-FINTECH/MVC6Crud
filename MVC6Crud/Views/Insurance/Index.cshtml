        // Handle Sign Up
       function handleSignUp() {
                   showLoader();

    const form = document.getElementById('signupForm');

    const nameInput = form.querySelector('input[name="name"]');
    const mobileInput = form.querySelector('input[name="mobile"]');
    const emailInput = form.querySelector('input[name="email"]');
    const passwordInput = form.querySelector('input[name="password"]');

    let isValid = true;

    [nameInput, mobileInput, emailInput, passwordInput].forEach(input => {
        if (!input.value.trim()) {
            input.classList.add('is-invalid');
            isValid = false;
        } else {
            input.classList.remove('is-invalid');
        }
    });

    const emailPattern = /^[^\s]+[^\s]+\.[^\s]+$/;
    if (!emailPattern.test(emailInput.value)) {
        emailInput.classList.add('is-invalid');
        isValid = false;
    }

    if (!isValid) return;

    $.ajax({
        url: '/Insurance/Register',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            name: nameInput.value,
            mobile: mobileInput.value,
            email: emailInput.value,
            password: passwordInput.value
        }),
        success: function (res) {
            if (res.isSuccess) {
                         hideLoader();

                alert('Account created successfully');

                bootstrap.Modal.getInstance(
                    document.getElementById('signupModal')
                ).hide();

                setTimeout(() => {
                    new bootstrap.Modal(
                        document.getElementById('loginModal')
                    ).show();
                }, 300);

            } else {
                         hideLoader();
                alert(res.message);
            }
        },
        error: function () {
                     hideLoader();
            alert('Server error');
        }
    });
}
        // Handle Forgot Password
        function handleForgotPassword() {
            const forgotForm = document.getElementById('forgotPasswordForm');
            const mobileInput = forgotForm.querySelector('input[type="tel"]');
            
            const mobilePattern = /^[0-9]{10}$/;
            if (!mobilePattern.test(mobileInput.value)) {
                mobileInput.classList.add('is-invalid');
                return;
            }
            
            mobileInput.classList.remove('is-invalid');
            
            // Show success message
            alert('OTP has been sent to your mobile number. Please check your SMS.');
            
            // Close modal
            const modal = bootstrap.Modal.getInstance(document.getElementById('forgotPasswordModal'));
            modal.hide();
            
            // Show login modal
            setTimeout(() => {
                const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
                loginModal.show();
            }, 300);
        }

        // Process Payment
        function processPayment() {
            const paymentForm = document.getElementById('paymentForm');
            const termsCheckbox = document.getElementById('terms');
            
            if (!termsCheckbox.checked) {
                termsCheckbox.classList.add('is-invalid');
                return;
            }
            
            termsCheckbox.classList.remove('is-invalid');
            
            // Close payment modal
            const paymentModal = bootstrap.Modal.getInstance(document.getElementById('paymentModal'));
            paymentModal.hide();
            
            // Show success modal after a short delay
            setTimeout(() => {
                const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                successModal.show();
            }, 500);
        }

        // Modal switching
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus on first input when modal opens
            document.querySelectorAll('.modal').forEach(modal => {
                modal.addEventListener('shown.bs.modal', function() {
                    const firstInput = this.querySelector('input, select, textarea');
                    if (firstInput) {
                        firstInput.focus();
                    }
                });
            });
            
            // Mobile number formatting
            document.querySelectorAll('input[type="tel"]').forEach(input => {
                input.addEventListener('input', function(e) {
                    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
                });
            });
        });
    </script>
}
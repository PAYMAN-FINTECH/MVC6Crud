    // Initialize page
    document.addEventListener('DOMContentLoaded', function() {


         const tabs = document.querySelectorAll('.tab');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', function() {
                const targetTab = this.getAttribute('data-tab');

                // Update active tab
                tabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                // Show corresponding content
                tabContents.forEach(content => {
                    content.classList.remove('active');
                    if (content.id === `${targetTab}-tab`) {
                        content.classList.add('active');
                    }
                });
            });
        });


         loadInsuranceCompanies();
        //initializeInsuranceGrid();
        hideLoading();

        // Hide login/signup buttons, show user info (simulating logged in state)
        updateNavbarForLoggedIn();
    });

     async function loadInsuranceCompanies() {
        try {
            const billerName = 'Insurance'; // category you want
            const userPhone = '9999999999'; // pass real phone if needed

            const response = await fetch(
                `/BillPayments/BillersList?BillerName=${billerName}&UserPhone=${userPhone}`
            );

            if (!response.ok) {
                throw new Error('Failed to fetch billers');
            }

            const data = await response.json();

            // Map API response to UI-friendly object
            const insuranceCompanies = data.billers.map(b => ({
                id: b.billerId,
                name: getShortName(b.billerName),
                fullName: b.billerName,
                type: b.category,
                logoClass: 'default-logo' // optional / dynamic
            }));

            initializeInsuranceGrid(insuranceCompanies);

        } catch (error) {
            console.error('Error loading insurance companies:', error);
        }
    }

        function getShortName(fullName) {
        return fullName
            .split(' ')
            .slice(0, 2)
            .map(w => w[0])
            .join('')
            .toUpperCase();
    }




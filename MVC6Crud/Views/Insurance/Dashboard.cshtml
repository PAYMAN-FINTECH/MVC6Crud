    // Initialize insurance grid
       function initializeInsuranceGrid(insuranceCompanies) {
        const grid = document.getElementById('insuranceGrid');
        grid.innerHTML = '';

        insuranceCompanies.forEach(company => {
            const card = document.createElement('div');
            card.className = 'insurance-card';
            card.setAttribute('data-id', company.id);

            card.innerHTML = `
                <div class="company-logo ${company.logoClass}">
                    ${company.name}
                </div>
                <div class="company-name">${company.fullName}</div>
                <div class="company-type">${company.type} Insurance</div>
            `;

                card.addEventListener('click', function () {
        selectInsurance(company, this);
    });
            grid.appendChild(card);
        });
    }

        async function selectInsurance(company, cardElement) {
        try {
            const userPhone = '9999999999';

            const response = await fetch(
                `/BillPayments/CheckBillerCategory?BillerId=${company.id}&UserPhone=${userPhone}`
            );

            // (You can re-enable category validation later)

            selectedInsurance = company;

            // Remove active class from all cards
            document.querySelectorAll('.insurance-card').forEach(card => {
                card.classList.remove('active');
            });

            // ✅ Add active class to clicked card
            cardElement.classList.add('active');

            // Show payment form
            showPaymentForm(company);

            // Scroll
            document.getElementById('paymentSection').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

        } catch (err) {
            console.error(err);
            alert('Something went wrong. Please try again.');
        }
    }
    // Show payment form
    function showPaymentForm(company) {
        const section = document.getElementById('paymentSection');

        section.innerHTML = `
            <h2 class="section-title">
                <i class="fas fa-credit-card me-2"></i>Payment Details
            </h2>

            <div class="form-row">
                <div class="form-group">
                    <label>Biller Name</label>
                    <input type="text" class="form-control" id="billerName"
                           value="${company.fullName}" readonly>
                </div>

                <div class="form-group">
                    <label>Mobile Number</label>
                    <input type="tel" class="form-control" id="mobileNumber"
                           placeholder="Enter mobile number" pattern="[0-9]{10}" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Date of Birth (DD/MM/YYYY)</label>
                    <input type="text" class="form-control" id="dob"
                           placeholder="DD/MM/YYYY" pattern="\\d{2}/\\d{2}/\\d{4}" required>
                </div>

                <div class="form-group">
                    <label>Email ID</label>
                    <input type="email" class="form-control" id="email"
                           placeholder="Enter email address" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Policy Number</label>
                    <input type="text" class="form-control" id="policyNumber"
                           placeholder="Enter policy number" required>
                </div>

                <div class="form-group">
                    <label>&nbsp;</label>
                    <button type="button" class="btn btn-outline w-100" onclick="viewBill()">
                        <i class="fas fa-file-invoice me-2"></i>View Bill
                    </button>
                </div>
            </div>


            <div id="billDetailsSection"></div>

            <div class="providers-section">
                <h3>Related Insurance Providers</h3>
                <div class="providers-grid">
                    ${relatedProviders.map(provider => `
                        <div class="provider-item" onclick="selectRelatedProvider('${provider}')">
                            <div class="provider-name">${provider}</div>
                            <div class="provider-type">${getProviderType(provider)}</div>
                        </div>
                    `).join('')}
                </div>
            </div>
        `;

        section.classList.add('active');
    }

    // Get provider type
    function getProviderType(providerName) {
        if (providerName.includes('Life')) return 'Life Insurance';
        if (providerName.includes('Health')) return 'Health Insurance';
        if (providerName.includes('Motor')) return 'Motor Insurance';
        if (providerName.includes('General')) return 'General Insurance';
        return 'Insurance';
    }

    // Select related provider
    function selectRelatedProvider(providerName) {
        // Find if this provider exists in our list
        const provider = insuranceCompanies.find(c =>
            c.fullName.includes(providerName) || providerName.includes(c.name)
        );

        if (provider) {
            selectInsurance(provider);
        } else {
            // Create a temporary provider object
            const tempProvider = {
                id: 999,
                name: providerName.split(' ')[0],
                fullName: providerName,
                type: getProviderType(providerName),
                logoClass: 'logo-general',
                billerName: providerName,
                description: 'Insurance provider'
            };

            selectInsurance(tempProvider);
        }
    }

    // View bill function
       async function viewBill() {
            showLoader();
        const billerName = document.getElementById('billerName').value;
        const policyNumber = document.getElementById('policyNumber').value;
        const mobile = document.getElementById('mobileNumber').value;
        const email = document.getElementById('email').value;
        const dob = document.getElementById('dob').value;

        // Basic validations
        if (!mobile || mobile.length !== 10) {
            hideLoader();
            alert('Please enter valid mobile number');
            return;
        }

        if (!dob) {
            hideLoader();
            alert('Please enter Date of Birth');
            return;
        }

        if (!email) {
            hideLoader();
            alert('Please enter Email ID');
            return;
        }

        if (!policyNumber) {
            hideLoader();
            alert('Please enter Policy Number');
            return;
        }

        try {
            const requestBody = {
                billerId: selectedInsurance.id,
                RegisteredMobile: mobile,
                CreditCardLast4: email,
                CustomerMobile: dob,
                ServiceNumber: policyNumber,
                userPhone: "9652724937",
                category: "Insurance"
            };

            const response = await fetch('/BillPayments/FetchBill', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestBody)
            });

            // if (!response.ok) {
            //     hideLoader();
            //     throw new Error('Fetch bill failed');
            // }

            
           

            const billData = await response.json();

            if(billData.status === false){
                hideLoader();
                 alert(billData.message);
                 return;
            }

            debugger;
             hideLoader();

                if (
        billData &&
        billData.billerResponse &&
        Object.keys(billData.billerResponse).length > 0
    ) {
        bindBillDetails(
            billData.billerResponse,
            billerName,
            policyNumber
        );
    } else {
         hideLoader();
        alert("Unable to fetch bill details. Please try again");

        
    }

        } catch (error) {
            hideLoader();
            console.error(error);
            alert('Unable to fetch bill. Please try again.');
        }
    }


    function bindBillDetails(data, billerName, policyNumber) {
        const billSection = document.getElementById('billDetailsSection');

        const payableAmount = Number(data.billAmount) / 100;

        billSection.innerHTML = `
            <div class="bill-details active">
                <div class="bill-summary">
                    <h4>Bill Details</h4>

                    <div class="bill-row">
                        <span class="label">Insurance Company:</span>
                        <span class="value">${selectedInsurance.fullName}</span>
                    </div>

                    <div class="bill-row">
                        <span class="label">Biller Name:</span>
                        <span class="value">${billerName}</span>
                    </div>

                    <div class="bill-row">
                        <span class="label">Policy Number:</span>
                        <span class="value">${policyNumber}</span>
                    </div>

                    <div class="bill-row">
                        <span class="label">customer Name:</span>
                        <span class="value">${data.customerName}</span>
                    </div>

                    <div class="bill-row">
                        <span class="label">Due Date:</span>
                        <span class="value">${data.dueDate ?? 'N/A'}</span>
                    </div>

                        <div class="bill-row">
        <span class="label">Premium Amount:</span>
        <span class="value">
            ₹ ${(Number(data.billAmount) / 100).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            })}
        </span>
    </div>
                </div>

                <div class="btn-group">
                    <button type="button" class="btn btn-outline" onclick="hideBill()">
                        <i class="fas fa-times me-2"></i>Hide Bill
                    </button>

                    <button type="button" class="btn btn-primary" onclick="showPaymentModal(${payableAmount})">
                        <i class="fas fa-lock me-2"></i>Process Payment
                    </button>
                </div>
            </div>
        `;
    }

    // Hide bill
    function hideBill() {
        const billSection = document.getElementById('billDetailsSection');
        billSection.innerHTML = '';
    }

    // Proceed to payment
    function proceedToPayment() {
        const billerName = document.getElementById('billerName').value;
        const policyNumber = document.getElementById('policyNumber').value;

        if (!policyNumber) {
            alert('Please enter policy number');
            document.getElementById('policyNumber').focus();
            return;
        }

        showPaymentModal();
    }

    // Show payment modal
    function showPaymentModal(payableAmount) {
        const billerName = document.getElementById('billerName').value;
        const policyNumber = document.getElementById('policyNumber').value;

        document.getElementById('modalInsuranceName').textContent = selectedInsurance.fullName;
        document.getElementById('modalBillerName').textContent = billerName;
        document.getElementById('modalPolicyNumber').textContent = policyNumber;
         document.getElementById('modalAmount').textContent = payableAmount;

        const modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();
    }

    // Process final payment
    function processFinalPayment() {
        const amount = document.getElementById('premiumAmount').value;

        if (!amount || amount <= 0) {
            alert('Please enter a valid premium amount');
            return;
        }

        document.getElementById('modalAmount').textContent = parseFloat(amount).toFixed(2);

        const payBtn = document.querySelector('#paymentModal .btn-primary');
        const originalText = payBtn.innerHTML;
        payBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
        payBtn.disabled = true;

        // Simulate API call
        setTimeout(() => {
            const modal = bootstrap.Modal.getInstance(document.getElementById('paymentModal'));
            modal.hide();

            alert(`Payment of ₹${amount} processed successfully! Receipt has been sent to your email.`);

            payBtn.innerHTML = originalText;
            payBtn.disabled = false;
            document.getElementById('premiumAmount').value = '';
            hideBill();

            // Reset form
            document.getElementById('policyNumber').value = '';
            document.getElementById('mobileNumber').value = '';
            document.getElementById('dob').value = '';
            document.getElementById('email').value = '';
        }, 2000);
    }

    // Hide loading
    function hideLoading() {
        document.getElementById('loadingState').style.display = 'none';
    }

    // Simulate loading from API
    setTimeout(hideLoading, 1000);
</script>
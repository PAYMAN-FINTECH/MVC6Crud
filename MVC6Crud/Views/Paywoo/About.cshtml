@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_PayWoo.cshtml";
}

<!-- Hero Section for About Us -->
<section class="relative bg-gradient-to-br from-[#0a253b] to-[#1d4a72] text-white py-20 md:py-28 px-6 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
        <img src="~/images/paywoo/about-hero-bg.jpg" alt="About Us Background" class="w-full h-full object-cover">
    </div>
    <div class="max-w-7xl mx-auto relative z-10 text-center">
        <span class="text-sm uppercase tracking-[0.2em] font-semibold bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30"><i class="fas fa-building mr-2"></i>ABOUT US</span>
        <h1 class="text-5xl md:text-7xl font-bold mt-8 leading-tight">PAYMAN FINTECH  <span class="text-amber-200">PRIVATE LIMITED</span></h1>
        <p class="text-xl text-gray-100 my-8 max-w-3xl mx-auto">Your Trusted Partner in Smart Daily Commute Solutions Across Telangana</p>
    </div>
</section>

<!-- Main About Content -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <!-- Who We Are -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-info-circle text-[#1f4a7a]"></i> WHO WE ARE</span>
        <h2 class="text-4xl md:text-5xl font-bold text-[#0a2942] leading-tight">Transforming Daily Commutes Across Telangana</h2>
        <p class="text-gray-600 text-lg mt-6 max-w-4xl">
            At PAYMAN FINTECH SOLUTIONS PVT LTD, we are committed to revolutionizing the way professionals commute to work. We believe that daily travel should be comfortable, reliable, stress-free, and sustainable. Our mission is to provide smart transportation solutions across Telangana that save time, reduce stress, and contribute to a greener environment.
        </p>
    </div>

    <!-- Who We Serve -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-users text-[#1f4a7a]"></i> WHO WE SERVE</span>
        <p class="text-gray-700 text-lg max-w-4xl">
            PAYMAN FINTECH SOLUTIONS PVT LTD is designed for working professionals, corporate teams, and businesses across Telangana looking for dependable daily commute solutions. We understand the challenges of urban transportation in cities like Hyderabad, Warangal, and Nizamabad, and have built our services around the needs of modern commuters who value punctuality, comfort, and safety.
        </p>
    </div>

    <!-- What We Offer -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-bus text-[#1f4a7a]"></i> WHAT WE OFFER</span>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-satellite-dish text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">GPS-Enabled Smart Buses</h3>
                <p class="text-gray-600">Track your bus in real-time and plan your commute efficiently.</p>
            </div>
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-clock text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">Fixed Routes & Timings</h3>
                <p class="text-gray-600">Predictable schedules you can rely on every single day.</p>
            </div>
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-wind text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">AC, Comfortable Seating</h3>
                <p class="text-gray-600">Travel in comfort with air-conditioned buses and guaranteed seating.</p>
            </div>
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-id-card text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">Professional Drivers</h3>
                <p class="text-gray-600">Experienced, verified, and trained drivers committed to your safety.</p>
            </div>
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-check-circle text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">On-Time Guarantee</h3>
                <p class="text-gray-600">95% on-time arrivals within 5 minutes of schedule.</p>
            </div>
            <div class="bg-[#f0f7ff] p-6 rounded-2xl border border-[#dce9f5]">
                <i class="fas fa-headset text-3xl text-[#1f4a7a] mb-3"></i>
                <h3 class="font-bold text-xl">24/7 Customer Support</h3>
                <p class="text-gray-600">Our dedicated support team is always available to assist you.</p>
            </div>
        </div>
    </div>

    <!-- Our Presence (Telangana only) -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-map-marked-alt text-[#1f4a7a]"></i> OUR PRESENCE</span>
        <p class="text-gray-700 text-lg max-w-4xl">
            PAYMAN FINTECH SOLUTIONS PVT LTD operates across the state of Telangana, with over <strong class="text-[#1f4a7a]">60+ active routes</strong> connecting major districts and business hubs. Our headquarters is in Hyderabad, and we are expanding our services to reach every corner of the state.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Hyderabad (HQ)</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Warangal</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Nizamabad</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Karimnagar</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Khammam</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Mahbubnagar</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Nalgonda</span>
            <span class="stat-pill text-lg"><i class="fas fa-city text-[#1f4a7a]"></i> Adilabad</span>
        </div>
    </div>

    <!-- Why Choose Us (stats) -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-chart-line text-[#1f4a7a]"></i> WHY CHOOSE US</span>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-8">
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
                <div class="text-4xl font-black text-[#1f4a7a]">63%</div>
                <p class="text-sm uppercase tracking-wide mt-2">reduced stress</p>
                <p class="text-gray-500 text-xs">compared to driving</p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
                <div class="text-4xl font-black text-[#1f4a7a]">41L</div>
                <p class="text-sm uppercase tracking-wide mt-2">hours reclaimed</p>
                <p class="text-gray-500 text-xs">by our commuters</p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
                <div class="text-4xl font-black text-[#1f4a7a]">53L kg</div>
                <p class="text-sm uppercase tracking-wide mt-2">CO2 reduced</p>
                <p class="text-gray-500 text-xs">environmental impact</p>
            </div>
            <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
                <div class="text-4xl font-black text-[#1f4a7a]">14L</div>
                <p class="text-sm uppercase tracking-wide mt-2">car trips avoided</p>
                <p class="text-gray-500 text-xs">in 2023</p>
            </div>
        </div>
    </div>

    <!-- Our Commitment -->
    <div class="mb-16">
        <span class="stat-pill mb-4 inline-block"><i class="fas fa-handshake text-[#1f4a7a]"></i> OUR COMMITMENT</span>
        <p class="text-gray-700 text-lg max-w-4xl">We are dedicated to maintaining the highest standards of service quality, safety, and reliability across Telangana. Every bus undergoes thorough cleaning and disinfection before every trip. Our drivers are trained in defensive driving and customer service. We continuously invest in technology and infrastructure to enhance your commute experience.</p>
    </div>

    <!-- Join Community -->
    <div class="bg-[#f0f7ff] p-10 rounded-3xl border border-[#cde0f0] text-center">
        <h3 class="text-3xl font-bold text-[#0a2942] mb-4">
            Join the PAYMAN FINTECH SOLUTIONS PVT LTD Community
        </h3>
        <p class="text-xl text-gray-700 mb-6">Join over <span class="font-bold text-[#1f4a7a]">4,200+ daily riders</span> across Telangana who trust us for their commute. Experience the difference of traveling with a service that truly cares about your time, comfort, and well-being.</p>
        <p class="text-lg mb-8">Ready to Transform Your Daily Commute?</p>
        <a href="#" class="bg-[#1f3a5f] text-white px-10 py-4 rounded-full font-bold text-lg inline-flex items-center gap-3 hover:bg-[#123256] transition shadow-lg"><span>Book Your Seat Today</span> <i class="fas fa-arrow-right"></i></a>
    </div>
</section>
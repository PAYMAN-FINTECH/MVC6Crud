                alert('Please enter valid mobile number');
                return;
            }

            const loader = document.getElementById('paymentLoader');
            const submitBtn = document.getElementById('paymentSubmitBtn');

            loader.classList.remove('hidden');
            submitBtn.disabled = true;

            // ✅ Generate Order ID
            const dd = new Date();
            let orderId = 'PAYMAN' + dd.getTime();

            // ✅ Prepare request body
            const requestBody = new URLSearchParams();
            requestBody.append('orderId', orderId);
            requestBody.append('amount', parseFloat(amount));
            requestBody.append('actionType', 1);
            requestBody.append('email', bookingData.email);
            requestBody.append('phone', '9849800697');
            requestBody.append('custmobile', bookingData.mobile);
            requestBody.append('custcard', '4222222222222222' || '');
            requestBody.append('custname', bookingData.name);
            requestBody.append('divice', 'web');

            // ✅ Call Payment API
            fetch('https://paymove.payman.in/Paymove/Initiate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: requestBody
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network error');
                }
                return response.json();
            })
            .then(res => {
                loader.classList.add('hidden');
                submitBtn.disabled = false;

                if (res.success && res.url) {
                    // ✅ Redirect to payment page
                    window.location.href = res.url;
                } else {
                    alert(res.message || 'Payment initiation failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);

                loader.classList.add('hidden');
                submitBtn.disabled = false;

                alert('Gateway error (601 possible). Please try again.');
            });
        });
    }

            // Step 4: Success
            function renderStep4(paymentId) {
                const bookingId = paymentId || ('TXN' + Math.floor(Math.random() * 1000000));

                const html = `
                    <div class="p-6 text-center">
                        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center text-3xl text-green-600 mx-auto mb-4">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-[#0a2942] mb-2">Booking Confirmed!</h2>
                        <p class="text-lg text-gray-600 mb-4">Thank you, <span class="font-semibold text-[#1f4a7a]">${bookingData.name}</span>!</p>
                        <div class="bg-[#f0f7ff] p-4 rounded-2xl inline-block mb-4">
                            <p class="text-xl font-mono font-bold text-[#1f4a7a]">Payment ID: ${bookingId}</p>
                        </div>
                        <p class="text-lg font-semibold text-[#0a2942] mb-2">Route: <span class="text-[#1f4a7a]">${pickupDistrict} → ${dropoffDistrict}</span></p>
                        <p class="text-lg font-semibold text-[#0a2942] mb-2">Bus: <span class="text-[#1f4a7a]">${selectedBus}</span></p>
                        <p class="text-lg font-semibold text-[#0a2942] mb-2">Date & Time: <span class="text-[#1f4a7a]">${travelDate} at ${travelTime}</span></p>
                        <p class="text-lg font-semibold text-[#0a2942] mb-3">Amount Paid: <span class="text-[#1f4a7a]">₹${amount}</span></p>
                        <p class="text-gray-600 text-sm max-w-md mx-auto mb-4">We've sent the details to your email and SMS. Our team will contact you shortly to confirm.</p>
                        <div class="flex justify-center gap-3">
                            <button type="button" id="closeSuccessBtn" class="bg-[#1f3a5f] text-white px-6 py-2 rounded-full text-sm font-semibold hover:bg-[#123256] transition">Close</button>
                            <button type="button" id="bookAnotherBtn" class="border border-[#1f3a5f] text-[#1f3a5f] px-6 py-2 rounded-full text-sm font-semibold hover:bg-[#f0f7ff] transition">Book Another</button>
                        </div>
                    </div>
                `;

                bookingContent.innerHTML = html;

                document.getElementById('closeSuccessBtn').addEventListener('click', closeBookingModal);
                document.getElementById('bookAnotherBtn').addEventListener('click', () => {
                    resetState();
                    renderStep1();
                });
            }

            bookBtn.addEventListener('click', (e) => {
                e.preventDefault();
                openBookingModal();
            });

            bookingOverlay.addEventListener('click', closeBookingModal);

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && !bookingModal.classList.contains('hidden')) {
                    closeBookingModal();
                }
            });
        })();
        // ========== END BOOKING MODAL WITH RAZORPAY ==========
    </script>
}
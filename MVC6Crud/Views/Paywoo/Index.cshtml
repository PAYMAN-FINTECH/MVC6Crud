@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_PayWoo.cshtml";
}

<!-- HERO section -->
<section class="relative bg-gradient-to-br from-[#0a253b] to-[#1d4a72] text-white py-20 md:py-28 px-6 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
        <img src="~/images/paywoo/ts1.webp" alt="hero background placeholder" class="w-full h-full object-cover">
    </div>
    <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-3xl">
            <span class="text-sm uppercase tracking-[0.2em] font-semibold bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30"><i class="fas fa-bus mr-2"></i>RECLAIM YOUR COMMUTE</span>
            <h1 class="text-5xl md:text-7xl font-bold mt-8 leading-tight">FLEXIBLE TRANSPORT <span class="text-amber-200">& MOBILITY SOLUTIONS</span></h1>
            <p class="text-xl text-gray-100 my-8 max-w-2xl">Smart, safe, and reliable daily commute solutions designed for modern cities, businesses, and professionals.</p>
            <div class="flex flex-wrap gap-4">
                <a href="#" id="bookSeatBtn" class="bg-white text-[#1f3a5f] px-8 py-4 rounded-full font-bold flex items-center gap-3 hover:bg-gray-100 transition shadow-xl hover:shadow-2xl"><span>Book Your Seat</span> <i class="fas fa-arrow-right"></i></a>
                <a href="#" class="border-2 border-white text-white px-8 py-4 rounded-full font-semibold flex items-center gap-3 hover:bg-white hover:text-[#1f3a5f] transition"><span>Explore routes</span> <i class="fas fa-map"></i></a>
            </div>
            <div class="flex flex-wrap gap-3 mt-12">
                <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm"><i class="fas fa-satellite-dish mr-1"></i> GPS-Enabled Smart Buses</span>
                <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm"><i class="fas fa-clock mr-1"></i> Fixed Routes & Timings</span>
                <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm"><i class="fas fa-wind mr-1"></i> AC, Comfortable Seating</span>
                <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm"><i class="fas fa-id-card mr-1"></i> Professional Drivers</span>
                <span class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-2 text-sm"><i class="fas fa-check-circle mr-1"></i> On-Time Guarantee</span>
            </div>
        </div>
    </div>
</section>

<!-- LET'S FIND YOU A BUS - Telangana Focused -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
        <span class="stat-pill"><i class="fas fa-search-location text-[#1f4a7a]"></i> FIND YOUR ROUTE</span>
        <h2 class="text-4xl font-bold text-[#0a2942] mt-4">Let's find you a bus across Telangana</h2>
        <p class="text-gray-600 text-lg mt-2">We are available in all <span class="font-semibold text-[#1f4a7a]">33 districts of Telangana</span> with convenient routes.</p>
    </div>

    <!-- Feature grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 bg-[#e7f0fa] rounded-full flex items-center justify-center text-xl text-[#1f4a7a] flex-shrink-0"><i class="fas fa-chair"></i></div>
            <div><h3 class="font-bold text-lg">Reserve a seat of your choice</h3><p class="text-gray-500 text-sm">Choose your preferred seat in advance.</p></div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 bg-[#e7f0fa] rounded-full flex items-center justify-center text-xl text-[#1f4a7a] flex-shrink-0"><i class="fas fa-calendar-alt"></i></div>
            <div><h3 class="font-bold text-lg">Reschedule your ride anytime</h3><p class="text-gray-500 text-sm">Change your plans with ease.</p></div>
        </div>
        <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm flex items-start gap-4">
            <div class="w-12 h-12 bg-[#e7f0fa] rounded-full flex items-center justify-center text-xl text-[#1f4a7a] flex-shrink-0"><i class="fas fa-undo-alt"></i></div>
            <div><h3 class="font-bold text-lg">Refund on ride cancellations</h3><p class="text-gray-500 text-sm">Hassle-free refunds as per policy.</p></div>
        </div>
    </div>

    <!-- Interactive location cards -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div id="pickup-card" class="location-card group cursor-pointer bg-white p-6 rounded-2xl border-2 border-gray-100 hover:border-[#1f4a7a] hover:shadow-xl transition-all duration-300 flex items-center gap-4" data-type="pickup">
            <div class="w-14 h-14 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-2xl text-[#1f4a7a] group-hover:scale-110 transition-transform">
                <i class="fas fa-circle-dot"></i>
            </div>
            <div class="flex-1">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Pickup location</div>
                <div class="text-lg font-semibold text-gray-800 group-hover:text-[#1f4a7a] transition-colors flex items-center gap-2">
                    <span id="pickup-location-display" class="location-display">Enter exact pickup location</span>
                    <i class="fas fa-chevron-right text-sm text-gray-400 group-hover:text-[#1f4a7a] transition-all group-hover:translate-x-1"></i>
                </div>
            </div>
        </div>

        <div id="dropoff-card" class="location-card group cursor-pointer bg-white p-6 rounded-2xl border-2 border-gray-100 hover:border-[#1f4a7a] hover:shadow-xl transition-all duration-300 flex items-center gap-4" data-type="dropoff">
            <div class="w-14 h-14 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-2xl text-[#1f4a7a] group-hover:scale-110 transition-transform">
                <i class="fas fa-location-dot"></i>
            </div>
            <div class="flex-1">
                <div class="text-sm font-medium text-gray-500 uppercase tracking-wide">Dropoff location</div>
                <div class="text-lg font-semibold text-gray-800 group-hover:text-[#1f4a7a] transition-colors flex items-center gap-2">
                    <span id="dropoff-location-display" class="location-display">Enter exact dropoff location</span>
                    <i class="fas fa-chevron-right text-sm text-gray-400 group-hover:text-[#1f4a7a] transition-all group-hover:translate-x-1"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Available Routes (Telangana-wide) -->
    <h3 class="text-2xl font-bold text-[#0a2942] mb-6">Popular Telangana Routes</h3>
    <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md">
            <h4 class="text-xl font-bold text-[#1f4a7a] mb-4">HYDERABAD ↔ WARANGAL</h4>
            <div class="space-y-2 text-gray-600">
                <p><span class="font-semibold">Via:</span> Hyderabad, Warangal Highway</p>
                <p><span class="font-semibold">Frequency:</span> Every 30 mins</p>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md">
            <h4 class="text-xl font-bold text-[#1f4a7a] mb-4">NIZAMABAD ↔ KARIMNAGAR</h4>
            <div class="space-y-2 text-gray-600">
                <p><span class="font-semibold">Via:</span> Armoor, Jagitial</p>
                <p><span class="font-semibold">Frequency:</span> Every 45 mins</p>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md">
            <h4 class="text-xl font-bold text-[#1f4a7a] mb-4">KHAMMAM ↔ BHADRADRI</h4>
            <div class="space-y-2 text-gray-600">
                <p><span class="font-semibold">Via:</span> Kothagudem, Palvancha</p>
                <p><span class="font-semibold">Frequency:</span> Every 60 mins</p>
            </div>
        </div>
    </div>

    <!-- Bus frequency -->
    <div class="grid md:grid-cols-2 gap-6 mt-12">
        <div class="bg-gradient-to-r from-[#0a253b] to-[#1d4a72] text-white p-6 rounded-2xl shadow-lg">
            <i class="fas fa-clock text-3xl mb-2"></i>
            <p class="text-lg font-semibold">Buses every 20 minutes between 08:40 AM – 12:31 PM</p>
        </div>
        <div class="bg-gradient-to-r from-[#0a253b] to-[#1d4a72] text-white p-6 rounded-2xl shadow-lg">
            <i class="fas fa-clock text-3xl mb-2"></i>
            <p class="text-lg font-semibold">Buses every 30 minutes between 07:20 AM – 10:21 AM</p>
        </div>
    </div>

    <!-- Location Selection Modal (Hyderabad areas) -->
    <div id="locationModal" class="fixed inset-0 z-[200] flex items-center justify-center px-4 py-6 hidden" aria-modal="true" role="dialog">
        <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="modalOverlay"></div>
        <div class="relative bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 id="modalTitle" class="text-2xl font-bold text-[#0a2942]">Select Pickup Location</h3>
                <button type="button" id="closeLocationModal" class="text-gray-400 hover:text-gray-600 transition">
                    <i class="fas fa-times text-2xl"></i>
                </button>
            </div>
            <div class="grid grid-cols-2 gap-3 max-h-80 overflow-y-auto p-1">
                <!-- Hyderabad areas -->
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Hitech City">Hitech City</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Gachibowli">Gachibowli</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Madhapur">Madhapur</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Kukatpally">Kukatpally</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Ameerpet">Ameerpet</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Secunderabad">Secunderabad</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Banjara Hills">Banjara Hills</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Jubilee Hills">Jubilee Hills</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Dilsukhnagar">Dilsukhnagar</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Uppal">Uppal</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Miyapur">Miyapur</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="L B Nagar">L B Nagar</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Koti">Koti</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Abids">Abids</div>
                <div class="location-option bg-gray-50 hover:bg-[#e7f0fa] hover:text-[#1f4a7a] p-3 rounded-xl text-center cursor-pointer transition-all" data-location="Begumpet">Begumpet</div>
            </div>
        </div>
    </div>
</section>

<!-- BOOKING MODAL -->
<div id="bookingModal" class="fixed inset-0 z-[300] flex items-center justify-center px-4 py-6 hidden" aria-modal="true" role="dialog">
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm" id="bookingModalOverlay"></div>
    <div class="relative bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl" id="bookingModalContent">
        <!-- Dynamic content will be loaded via JavaScript -->
    </div>
</div>

<!-- ABOUT US (summary) -->
<section id="about" class="max-w-7xl mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row gap-12 items-center">
        <div class="md:w-1/2">
            <span class="stat-pill mb-4 inline-block"><i class="fas fa-info-circle text-[#1f4a7a]"></i> ABOUT US</span>
            <h2 class="text-4xl md:text-5xl font-bold text-[#0a2942] leading-tight">Making daily office commute comfortable, reliable, and stress‑free</h2>
            <p class="text-gray-600 text-lg mt-6">Smart Daily Commute Solutions for Working Professionals. App-based AC buses with fixed routes, guaranteed seating, and on-time travel.</p>
            <div class="flex flex-wrap gap-4 mt-8">
                <div class="stat-pill text-xl px-6 py-3"><i class="fas fa-route text-[#1f4a7a]"></i> 60+ Active Routes</div>
                <div class="stat-pill text-xl px-6 py-3"><i class="fas fa-headset text-[#1f4a7a]"></i> 24/7 Support</div>
            </div>
            <p class="text-gray-700 mt-8">We integrate technology, prioritize safety, and ensure reliability to deliver a superior daily commute experience trusted by professionals and enterprises.</p>
            <div class="grid grid-cols-2 gap-3 mt-8">
                <div class="flex items-center gap-2"><i class="fas fa-chair text-[#1f4a7a]"></i> Reserve a seat</div>
                <div class="flex items-center gap-2"><i class="fas fa-calendar-alt text-[#1f4a7a]"></i> Reschedule anytime</div>
                <div class="flex items-center gap-2"><i class="fas fa-undo-alt text-[#1f4a7a]"></i> Refund on cancellation</div>
                <div class="flex items-center gap-2"><i class="fas fa-route text-[#1f4a7a]"></i> Fixed Routes & Timings</div>
                <div class="flex items-center gap-2 col-span-2"><i class="fas fa-snowflake text-[#1f4a7a]"></i> AC Buses with Guaranteed Seating</div>
            </div>
        </div>
        <div class="md:w-1/2">
            <img src="~/images/paywoo/img-1.png" alt="about us" class="w-full rounded-3xl shadow-xl hover-lift">
        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->

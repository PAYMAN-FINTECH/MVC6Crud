<!-- HOW IT WORK -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center mb-10">
        <span class="stat-pill"><i class="fas fa-play-circle"></i> HOW IT WORK</span>
        <h2 class="text-4xl font-bold text-[#0a2942] mt-4">It's simple to take a ride. Just search, select and it's done!</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-[#f7fafd] p-6 rounded-3xl text-center hover-lift">
            <img src="~/images/paywoo/ts4.jpg" alt="step1" class="w-full h-32 object-cover rounded-2xl mb-4">
            <div class="w-12 h-12 rounded-full bg-[#1f4a7a] text-white text-xl flex items-center justify-center mx-auto -mt-10 border-4 border-white">1</div>
            <h3 class="font-bold text-lg mt-4">Select your ride</h3>
            <p class="text-gray-500">Pickup, dropoff & preferred seat.</p>
        </div>

@section Scripts {
    <script>
        // Auto-scrolling testimonial carousel (unchanged)
        (function() {
            const slides = document.querySelectorAll('.testimonial-slide');
            const dots = document.querySelectorAll('.testimonial-dot');
            if (!slides.length) return;
            let current = 0;
            const total = slides.length;

            function showSlide(index) {
                slides.forEach((s, i) => {
                    s.classList.toggle('active', i === index);
                });
                dots.forEach((d, i) => {
                    d.classList.toggle('bg-[#1f4a7a]', i === index);
                    d.classList.toggle('bg-gray-300', i !== index);
                });
            }

            function nextSlide() {
                current = (current + 1) % total;
                showSlide(current);
            }

            let interval = setInterval(nextSlide, 5000);

            dots.forEach((dot, i) => {
                dot.addEventListener('click', () => {
                    clearInterval(interval);
                    current = i;
                    showSlide(current);
                    interval = setInterval(nextSlide, 5000);
                });
            });
        })();

        // Location selection modal functionality (unchanged)
        (function() {
            const pickupCard = document.getElementById('pickup-card');
            const dropoffCard = document.getElementById('dropoff-card');
            const modal = document.getElementById('locationModal');
            const overlay = document.getElementById('modalOverlay');
            const closeBtn = document.getElementById('closeLocationModal');
            const modalTitle = document.getElementById('modalTitle');
            const locationOptions = document.querySelectorAll('.location-option');

            let currentType = 'pickup';

            function openModal(type) {
                currentType = type;
                modalTitle.innerText = type === 'pickup' ? 'Select Pickup Location' : 'Select Dropoff Location';
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }

            if (pickupCard) pickupCard.addEventListener('click', () => openModal('pickup'));
            if (dropoffCard) dropoffCard.addEventListener('click', () => openModal('dropoff'));

            if (overlay) overlay.addEventListener('click', closeModal);
            if (closeBtn) closeBtn.addEventListener('click', closeModal);

            locationOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const location = this.dataset.location;
                    const displayElement = document.getElementById(currentType === 'pickup' ? 'pickup-location-display' : 'dropoff-location-display');

                    if (displayElement) {
                        displayElement.innerText = location;
                        displayElement.classList.add('text-[#1f4a7a]', 'font-semibold');

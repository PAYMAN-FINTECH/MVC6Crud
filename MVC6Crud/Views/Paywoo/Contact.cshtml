@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_PayWoo.cshtml";
}

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-[#0a253b] to-[#1d4a72] text-white py-20 md:py-28 px-6 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
        <img src="~/images/paywoo/contact-hero-bg.jpg" alt="Contact Background" class="w-full h-full object-cover">
    </div>
    <div class="max-w-7xl mx-auto relative z-10 text-center">
        <span class="text-sm uppercase tracking-[0.2em] font-semibold bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30"><i class="fas fa-phone-alt mr-2"></i>CONTACT US</span>
        <h1 class="text-5xl md:text-7xl font-bold mt-8 leading-tight">We're Here to Help - <span class="text-amber-200">Reach Out Anytime</span></h1>
        <p class="text-xl text-gray-100 my-8 max-w-3xl mx-auto">Get in touch with our team for any questions or support.</p>
    </div>
</section>

<!-- Contact Information Cards -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
        <span class="stat-pill"><i class="fas fa-heart text-[#1f4a7a]"></i> GET IN TOUCH</span>
        <h2 class="text-4xl font-bold text-[#0a2942] mt-4">We'd Love to Hear From You</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
        <!-- Call Us -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-phone-alt"></i>
            </div>
            <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Call Us</h3>
            <p class="text-gray-500 mb-3">24/7 Customer Support</p>
            <p class="text-xl font-semibold text-[#1f4a7a]">+91 9652724937</p>
        </div>

        <!-- Email Us -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-envelope"></i>
            </div>
            <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Email Us</h3>
            <p class="text-gray-500 mb-3">Send us your queries</p>
            <p class="text-xl font-semibold text-[#1f4a7a]">support@paymanfintech.in</p>
        </div>

        <!-- Visit Us -->
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-map-marker-alt"></i>
            </div>
            <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Visit Us</h3>
            <p class="text-gray-500 mb-3">Our Office Location</p>
            <p class="text-base font-medium text-gray-700">
                9-12 STREET NO 1, H M T NAGAR,NACHARAM, PIN CODE - 500076, CIRCLE 1,HYDERABAD
            </p>
        </div>
    </div>
</section>

<!-- Contact Form + Map -->
<section class="bg-[#f4f9ff] py-20 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12">
            <!-- Contact Form -->
            <div>
                <span class="stat-pill mb-4 inline-block"><i class="fas fa-paper-plane text-[#1f4a7a]"></i> SEND US A MESSAGE</span>
                <h3 class="text-3xl font-bold text-[#0a2942] mb-6">We'd love to hear from you</h3>
                <form class="space-y-5">
                    <div class="grid sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Your Name *</label>
                            <input type="text" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition" placeholder="John Doe">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Your Email *</label>
                            <input type="email" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition" placeholder="john@example.com">
                        </div>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
                            <input type="tel" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition" placeholder="+91 98765 43210">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
                            <input type="text" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition" placeholder="General Inquiry">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Your Message *</label>
                        <textarea rows="5" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition" placeholder="How can we help you?"></textarea>
                    </div>
                    <div>
                        <button type="submit" class="bg-[#1f3a5f] text-white px-8 py-4 rounded-full font-bold text-lg inline-flex items-center gap-3 hover:bg-[#123256] transition shadow-lg">
                            <span>Send Message</span> <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Map and Hours -->
            <div>
                <div class="mb-8">
                    <span class="stat-pill mb-4 inline-block"><i class="fas fa-map text-[#1f4a7a]"></i> FIND US ON MAP</span>
                    <div class="bg-gray-200 rounded-3xl overflow-hidden h-64 md:h-80">
                        <!-- Replace with actual map embed or image -->
                        <img src="https://placehold.co/800x400/1f4a7a/white?text=Google+Map+Placeholder" alt="Map location" class="w-full h-full object-cover">
                    </div>
                </div>

                <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md">
                    <span class="stat-pill mb-4 inline-block"><i class="fas fa-clock text-[#1f4a7a]"></i> BUSINESS HOURS</span>
                    <div class="space-y-4">
                        <div>
                            <h4 class="font-bold text-lg text-[#0a2942]">Customer Support</h4>
                            <p class="text-gray-600">Available 24/7 for your assistance</p>
                        </div>
                        <div>
                            <h4 class="font-bold text-lg text-[#0a2942]">Office Hours</h4>
                            <p class="text-gray-600">Monday - Saturday: 9:00 AM - 6:00 PM</p>
                            <p class="text-gray-600">Sunday: Closed</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
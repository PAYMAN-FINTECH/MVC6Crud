@{
    ViewData["Title"] = "Services & Pricing";
    Layout = "~/Views/Shared/_PayWoo.cshtml";
}

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-[#0a253b] to-[#1d4a72] text-white py-20 md:py-28 px-6 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-20">
        <img src="~/images/paywoo/services-hero-bg.jpg" alt="Services Background" class="w-full h-full object-cover">
    </div>
    <div class="max-w-7xl mx-auto relative z-10 text-center">
        <span class="text-sm uppercase tracking-[0.2em] font-semibold bg-white/20 backdrop-blur-sm px-4 py-2 rounded-full border border-white/30"><i class="fas fa-cogs mr-2"></i>SERVICES & PRICING</span>
        <h1 class="text-5xl md:text-7xl font-bold mt-8 leading-tight">Choose the Perfect Plan for <span class="text-amber-200">Your Daily Commute</span></h1>
    </div>
</section>

<!-- Our Services -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
        <span class="stat-pill"><i class="fas fa-bus text-[#1f4a7a]"></i> OUR SERVICES</span>
        <h2 class="text-4xl font-bold text-[#0a2942] mt-4">Smart Transportation Solutions for Every Need</h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Daily Commute -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-bus"></i>
            </div>
            <h3 class="text-xl font-bold text-[#0a2942] mb-2">Daily Commute</h3>
            <p class="text-gray-500">Regular AC bus service with fixed routes and timings for your daily office commute.</p>
        </div>
        <!-- Monthly Pass -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <h3 class="text-xl font-bold text-[#0a2942] mb-2">Monthly Pass</h3>
            <p class="text-gray-500">Unlimited rides for a month with guaranteed seating and priority booking.</p>
        </div>
        <!-- Corporate Plans -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-building"></i>
            </div>
            <h3 class="text-xl font-bold text-[#0a2942] mb-2">Corporate Plans</h3>
            <p class="text-gray-500">Customized transportation solutions for businesses and corporate teams.</p>
        </div>
        <!-- Flexible Tickets -->
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
            <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <h3 class="text-xl font-bold text-[#0a2942] mb-2">Flexible Tickets</h3>
            <p class="text-gray-500">Pay-per-ride options for occasional travelers with no commitment.</p>
        </div>
    </div>
</section>

<!-- Pricing Plans -->
<section class="bg-[#f4f9ff] py-20 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <span class="stat-pill"><i class="fas fa-tags text-[#1f4a7a]"></i> PRICING PLANS</span>
            <h2 class="text-4xl font-bold text-[#0a2942] mt-4">Affordable Rates for Everyone</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            <!-- Single Trip -->
            <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift relative">
                <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Single Trip</h3>
                <div class="flex items-baseline mb-4">
                    <span class="text-3xl font-bold text-[#1f4a7a]">₹50</span>
                    <span class="text-gray-500 ml-1">/trip</span>
                </div>
                <p class="text-gray-500 mb-6">Perfect for occasional travelers</p>
                <ul class="space-y-3 mb-8 text-gray-600">
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> AC Bus Service</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Guaranteed Seating</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> GPS Tracking</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Professional Drivers</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> On-Time Guarantee</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> 24/7 Support</li>
                </ul>
                <a href="#" class="block text-center bg-[#1f3a5f] text-white py-3 rounded-full font-semibold hover:bg-[#123256] transition">Book Now</a>
            </div>

            <!-- Weekly Pass (Most Popular) -->
            <div class="bg-white p-8 rounded-3xl border-2 border-[#1f4a7a] shadow-xl hover-lift relative transform scale-105 md:scale-110 z-10">
                <div class="absolute top-0 right-0 bg-[#1f4a7a] text-white px-4 py-1 rounded-bl-2xl rounded-tr-2xl text-sm font-bold">MOST POPULAR</div>
                <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Weekly Pass</h3>
                <div class="flex items-baseline mb-4">
                    <span class="text-3xl font-bold text-[#1f4a7a]">₹300</span>
                    <span class="text-gray-500 ml-1">/week</span>
                </div>
                <p class="text-gray-500 mb-6">Best value for regular commuters</p>
                <ul class="space-y-3 mb-8 text-gray-600">
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Unlimited Rides (7 days)</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Priority Booking</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> AC Bus Service</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Guaranteed Seating</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> GPS Tracking</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Free Rescheduling</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> 24/7 Priority Support</li>
                </ul>
                <a href="#" class="block text-center bg-[#1f4a7a] text-white py-3 rounded-full font-semibold hover:bg-[#123256] transition">Get Started</a>
            </div>

            <!-- Monthly Pass -->
            <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift relative">
                <h3 class="text-2xl font-bold text-[#0a2942] mb-2">Monthly Pass</h3>
                <div class="flex items-baseline mb-4">
                    <span class="text-3xl font-bold text-[#1f4a7a]">₹1,000</span>
                    <span class="text-gray-500 ml-1">/month</span>
                </div>
                <p class="text-gray-500 mb-6">Maximum savings for daily users</p>
                <ul class="space-y-3 mb-8 text-gray-600">
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Unlimited Rides (30 days)</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> VIP Priority Booking</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Premium AC Bus Service</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Reserved Seating</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> GPS Tracking</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Unlimited Rescheduling</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> Dedicated Support Manager</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-500"></i> 10% Discount on Renewals</li>
                </ul>
                <a href="#" class="block text-center bg-[#1f3a5f] text-white py-3 rounded-full font-semibold hover:bg-[#123256] transition">Subscribe Now</a>
            </div>
        </div>
    </div>
</section>

<!-- Corporate & Bulk Booking -->
<section class="max-w-7xl mx-auto px-6 py-20">
    <div class="bg-gradient-to-br from-[#0a253b] to-[#1d4a72] text-white p-10 md:p-16 rounded-3xl">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <div>
                <span class="stat-pill bg-white/10 text-white border-white/20 mb-4 inline-block"><i class="fas fa-building"></i> CORPORATE PLANS</span>
                <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-6">Corporate & Bulk Booking Plans</h2>
                <p class="text-gray-200 text-lg mb-6">Looking for transportation solutions for your entire team? We offer customized corporate plans with special rates, dedicated routes, and flexible scheduling options.</p>
                <ul class="grid grid-cols-2 gap-3 text-gray-200 mb-8">
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Customized Routes</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Flexible Timings</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Volume Discounts</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Dedicated Account Manager</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Monthly Invoicing</li>
                    <li class="flex items-center gap-2"><i class="fas fa-check-circle text-green-300"></i> Real-time Reporting</li>
                </ul>
                <div class="flex items-center gap-4">
                    <span class="text-2xl font-light">Starting from <span class="text-4xl font-bold text-amber-300">₹800</span><span class="text-lg">/employee/month</span></span>
                </div>
            </div>
            <div class="text-center md:text-right">
                <a href="#" class="inline-block bg-white text-[#1f3a5f] px-10 py-4 rounded-full font-bold text-lg hover:bg-gray-100 transition shadow-xl"><span>Contact Sales</span> <i class="fas fa-arrow-right ml-2"></i></a>
            </div>
        </div>
    </div>
</section>

<!-- What's Included In All Plans -->
<section class="bg-[#f4f9ff] py-20 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <span class="stat-pill"><i class="fas fa-gem text-[#1f4a7a]"></i> WHAT'S INCLUDED</span>
            <h2 class="text-4xl font-bold text-[#0a2942] mt-4">All Plans Include These Benefits</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
                <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h3 class="text-xl font-bold text-[#0a2942] mb-2">Safety First</h3>
                <p class="text-gray-500">Verified drivers, sanitized buses, and comprehensive insurance coverage.</p>
            </div>
            <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
                <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                    <i class="fas fa-clock"></i>
                </div>
                <h3 class="text-xl font-bold text-[#0a2942] mb-2">On-Time Guarantee</h3>
                <p class="text-gray-500">95% on-time arrivals within 5 minutes of scheduled time.</p>
            </div>
            <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-md hover-lift text-center">
                <div class="w-16 h-16 bg-[#e7f0fa] rounded-2xl flex items-center justify-center text-3xl text-[#1f4a7a] mx-auto mb-4">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h3 class="text-xl font-bold text-[#0a2942] mb-2">Real-Time Tracking</h3>
                <p class="text-gray-500">Track your bus location and estimated arrival time via our app.</p>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="max-w-4xl mx-auto px-6 py-20">
    <span class="stat-pill mx-auto block w-fit"><i class="fas fa-question-circle"></i> FREQUENTLY ASKED QUESTIONS</span>
    <h2 class="text-4xl font-bold text-center text-[#0a2942] mt-4 mb-12">Got Questions? We've Got Answers.</h2>
    <div class="space-y-4">
        <div class="bg-white rounded-2xl p-5 border border-gray-200 hover:border-[#1f4a7a] transition">
            <details class="group">
                <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-lg">
                    Can I upgrade my plan later?
                    <i class="fas fa-chevron-down group-open:rotate-180 transition"></i>
                </summary>
                <p class="mt-3 text-gray-600">Yes! You can upgrade from single trip to weekly or monthly pass at any time. The remaining value will be adjusted in your new plan.</p>
            </details>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-gray-200 hover:border-[#1f4a7a] transition">
            <details class="group">
                <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-lg">
                    What payment methods do you accept?
                    <i class="fas fa-chevron-down group-open:rotate-180 transition"></i>
                </summary>
                <p class="mt-3 text-gray-600">We accept all major credit/debit cards, UPI, net banking, and digital wallets. For corporate clients, we also offer monthly invoicing.</p>
            </details>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-gray-200 hover:border-[#1f4a7a] transition">
            <details class="group">
                <summary class="flex justify-between items-center cursor-pointer list-none font-semibold text-lg">
                    Is there a cancellation fee?
                    <i class="fas fa-chevron-down group-open:rotate-180 transition"></i>
                </summary>
                <p class="mt-3 text-gray-600">Cancellations made up to 60 minutes before departure are free. Cancellations within 60 minutes may incur a small fee. Pass holders enjoy free cancellations.</p>
            </details>
        </div>
    </div>
</section>
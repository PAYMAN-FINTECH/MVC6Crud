         // Reset Password
        $("#resetPasswordForm").on("submit", function (e) {
            e.preventDefault();
            $('#Loader1').show();
             const phone = $('#resetPhone').val();

            var data = {
                mobile: phone,
                otp: $(this).find("[name=oldPassword]").val(),
                newPassword: $(this).find("[name=newPassword]").val()
            };

            if (data.NewPassword !== data.ConfirmPassword) {
                alert("New and Confirm password do not match!");
                $('#Loader1').hide();
                return;
            }

            $.ajax({
                url: "https://srredu.in/Users/ResetPassword",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function () {
                    $('#Loader1').hide();
                    alert("Password changed successfully!");
                    $("#resetPasswordModal").modal("hide");
                },
                error: function (xhr) {
                    $('#Loader1').hide();
                    alert("Error: " + xhr.responseText);
                }
            });
        });

        $("#openHistoryBtn").on("click", function () {
            $("#historyModal").modal("show");
            loadHistoryData();
        });

         function loadHistoryData() {
            $("#historyLoader").show();
            $("#historyTable tbody").empty();

            $.ajax({
                url: "/FasTag/History", // 🔹 API endpoint (update to your actual API)
                method: "GET",
                success: function (response) {
                    $("#historyLoader").hide();

                    if (response && response.length > 0) {
                        $.each(response, function (index, item) {
                            let row = `
                                <tr>
                                    <td>${index + 1}</td>
                                    <td>${item.refId}</td>
                                    <td>${item.accountNo}</td>
                                    <td>${item.dateTime}</td>
                                    <td>₹${item.amount}</td>
                                    <td>
                                        <span class="badge ${item.status === 'Success' ? 'bg-success' : 'bg-danger'}">
                                            ${item.status}
                                        </span>
                                    </td>
                                </tr>`;
                            $("#historyTable tbody").append(row);
                        });
                    } else {
                        $("#historyTable tbody").append(`
                            <tr><td colspan="5" class="text-muted">No history found</td></tr>
                        `);
                    }
                },
                error: function () {
                    $("#historyLoader").hide();
                    $("#historyTable tbody").append(`
                        <tr><td colspan="5" class="text-danger">Failed to load data</td></tr>
                    `);
                }
            });
        }


        });

        // Fetch Biller Providers
        function fetchFastTagProviders() {
            $.ajax({
                url: 'https://paymanfintech.in/FasTag/FastTagBillers',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    let $dropdown = $('#fastTagProvider');
                    $dropdown.empty().append('<option value="">-- Select Provider --</option>');
                    $.each(data.billers, function (index, item) {
                        $dropdown.append(
                            $('<option>', {
                                value: item.billerId,
                                text: item.billerName
                            })
                        );
                    });
                    // ✅ Restore selected provider after dropdown is filled
            const billerId1 = localStorage.getItem("billerId1");
            if (billerId1) {
                $dropdown.val(billerId1);
            }
                },
                error: function () {
                    $('#fastTagProvider').html('<option value="">Failed to load billers</option>');
                }
            });
        }



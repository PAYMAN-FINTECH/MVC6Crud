            $("#registerForm").on("submit", function (e) {
                e.preventDefault();
                $('#Loader1').show();

                var data = {
                    FirstName: $(this).find("[name=firstName]").val(),
                    LastName: $(this).find("[name=lastName]").val(),
                    Email: $(this).find("[name=email]").val(),
                    Phone: $(this).find("[name=mobile]").val(),
                    Gender: $(this).find("[name=gender]").val(),
                    Password: $(this).find("[name=password]").val()
                };

                $.ajax({
                    url: "https://srredu.in/Users/FastTrackRegister", // 🔹 your API endpoint
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (res) {
                        $('#Loader1').hide();
                        alert("Registration success!");
                        $("#registerModal").modal("hide");
                       // location.reload();
                       $("#loginModal").modal("show");
                    },
                    error: function (xhr) {
                        $('#Loader1').hide();
                        alert("Register failed: " + xhr.responseText);
                    }
                });
            });


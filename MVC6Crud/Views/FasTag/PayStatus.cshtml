@model MVC6Crud.Models.PaymanWeb.PaymentStatusViewModel
@{
    ViewBag.Title = "Payment Status";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Payment Status</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f5f7fa;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .status-container {
            text-align: center;
            background: #fff;
            padding: 30px 40px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 90%;
        }

        .status-icon {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .success-icon {
            color: #2ecc71;
        }

        .fail-icon {
            color: #e74c3c;
        }

        h2 {
            margin: 0;
            font-size: 24px;
            color: #2c3e50;
        }

        .amount {
            margin-top: 10px;
            font-size: 18px;
            color: #34495e;
        }

        .redirect-msg {
            font-size: 14px;
            margin-top: 20px;
            color: #7f8c8d;
        }
    </style>
</head>
<body>
    <div class="status-container">
        @if (Model.IsSuccess)
        {
            <div class="status-icon success-icon">&#10004;</div>
            <h2>Payment Successful</h2>
            <div class="amount">Amount: ₹@Model.Amount</div>
            <div class="redirect-msg">Redirecting to dashboard in 3 seconds...</div>
        }
        else
        {
            <div class="status-icon fail-icon">&#10006;</div>
            <h2>Payment Failed</h2>
            <div class="amount">Amount: ₹@Model.Amount</div>
            <div class="redirect-msg">Redirecting to dashboard in 3 seconds...</div>
        }
    </div>

    <script>
        setTimeout(function () {
            if (window.opener) {
                // Opened in new window
                window.opener.location.href = '/FasTag/Index';
                window.close();
            } else if (window.parent && window.parent !== window) {
                // In iframe/modal
                window.parent.location.href = '/FasTag/Index';
            } else {
                // Normal page
                window.location.href = '/FasTag/Index';
            }
        }, 3000);
    </script>
</body>
</html>

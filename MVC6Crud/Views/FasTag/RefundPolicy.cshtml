@{
    ViewData["Title"] = "Refund & Cancellation Policy";
    Layout = "~/Views/Shared/_FasTag.cshtml";  // adjust if your layout path is different
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">Refund & Cancellation Policy</h2>

    <h5 class="mt-3">FASTag Recharge Refund & Cancellation Policy</h5>

    <div class="mt-3">
        <h6><strong>1. No Cancellations</strong></h6>
        <p>
            All recharges are final. We do not support cancellation or change of any FASTag recharge after it is successfully processed.
            Please ensure you enter the correct vehicle number and FASTag provider before initiating payment.
        </p>

        <h6><strong>2. Refunds for Failed Transactions</strong></h6>
        <p>
            If your money was deducted but the recharge failed or was not credited to your FASTag wallet, a refund will be initiated automatically or upon request
            within <strong>5-7 working days</strong> after confirmation.
        </p>

        <h6><strong>3. Incorrect Information</strong></h6>
        <p>
            We are not responsible for incorrect vehicle number or provider details submitted by users. Please verify all data before completing payment.
        </p>

        <h6><strong>4. Requesting a Refund</strong></h6>
        <p>
            To raise a refund request for failed transactions, email us at <a href="mailto:support@paymanfintech.in">support@paymanfintech.in</a> with:
        </p>
        <ul>
            <li>Transaction ID</li>
            <li>Vehicle Number</li>
            <li>Recharge Date</li>
            <li>Amount</li>
            <li>FASTag Provider</li>
        </ul>

        <h6><strong>5. Dispute Resolution</strong></h6>
        <p>
            Any refund-related disputes will be subject to applicable laws and handled under the jurisdiction of our operational city or as per our partner bank’s guidelines.
        </p>
    </div>

    <div class="mt-5">
        <h6>Contact / Office:</h6>
        <p>
            9-12 HMT NAGAR STNUMBER 1,<br />
            NACHARAM, HYDERABAD, 500076<br />
            Telangana India<br />
            +91-9100748033<br />
            <a href="mailto:support@paymanfintech.in">support@paymanfintech.in</a>
        </p>
    </div>
</div>

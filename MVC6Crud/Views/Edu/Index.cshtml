<!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    html {
        scroll-behavior: smooth;
    }

    .carousel-item img {
        width: 100%;
        height: auto;
        max-height: 170px;
        object-fit: cover;
    }

    .theme-divider {
        width: 80px;
        height: 3px;
        background-color: #0d6efd;
        margin: 0 auto 20px auto;
    }

    .card:hover {
        transform: scale(1.03);
        transition: transform 0.3s ease-in-out;
    }

    .brand-sub {
        font-size: 0.5em;
        text-transform: lowercase;
    }

    .card {
        background-color: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }

    .card-header {
        background-color: #ff0000;
        color: white;
        font-weight: bold;
        padding: 0.25rem 0.5rem;
    }

    .card-body {
        padding: 1rem;
    }

        .card-body p {
            margin-bottom: 0.5rem;
            font-size: 14px;
        }
</style>

<div class="row pb-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert" id="successAlert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        <script>
            setTimeout(function () {
                var alert = document.getElementById('successAlert');
                if (alert) { var bsAlert = new bootstrap.Alert(alert); bsAlert.close(); }
            }, 3000);
        </script>
    }

    <!-- Banner Carousel -->
    <header class="main-banner-sec">
        <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active"><img src="~/images/edu/3.jpg" class="d-block w-100" alt="Banner"></div>
                <div class="carousel-item"><img src="~/images/edu/5-1.jpg" class="d-block w-100" alt="Banner"></div>
                <div class="carousel-item"><img src="~/images/edu/6.jpg" class="d-block w-100" alt="Banner"></div>
                <div class="carousel-item"><img src="~/images/edu/Sathya-Web_Banners-1.jpg" class="d-block w-100" alt="Banner"></div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        </div>
    </header>

    <div class="container py-5" id="coursesSection">
        <h3 class="mb-4">Explore eduPAYMAN Degrees</h3>
        <p class="lead mb-4">Choose a category below to find the perfect program for your career goals, or browse all courses.</p>
        <div class="row">
            <!-- Category Dropdown (Education selected by default) -->
            <div class="col-md-3">
                <h5 class="mb-3">Categories</h5>
                <select class="form-select" id="categorySelect" aria-label="Category dropdown">
                    <option value="All">All Categories</option>
                    <option value="Education" selected>Education (Tech)</option>
                    <option value="Music">Music</option>
                    <option value="Drama">Drama</option>
                    <option value="Art">Art</option>
                    <option value="Cooking">Cooking</option>
                    <option value="Modeling">Modeling</option>
                    <option value="Karate">Karate</option>
                    <option value="Driving Instruction">Driving Instruction</option>
                    <option value="Traffic Safety">Traffic Safety</option>
                    <option value="Flying Instruction">Flying Instruction</option>
                    <option value="Sewing">Sewing</option>
                    <option value="Knitting Instruction">Knitting Instruction</option>
                </select>
            </div>

            <!-- Courses Grid -->
            <div class="col-md-9">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="courseContainer">
                    @foreach (var course in courses)
                    {
                        <div class="col course-card" data-category="@course.Category">
                            <div class="card shadow h-100">
                                <!-- Header -->
                                <div style="background-color:#0a2a66; color:white; padding:20px; position:relative; min-height:100px;">
                                    <h6 class="m-0" style="font-size:16px; font-weight:bold; max-width:70%;">
                                        @course.Name
                                    </h6>
                                    <span style="position:absolute; top:10px; right:10px; background-color:red; color:white; font-size:12px; font-weight:bold; padding:4px 10px; border-radius:6px;">
                                        LIVE Classes
                                    </span>
                                </div>

                                <!-- Body -->
                                <div class="card-body">
                                    <h6 class="fw-bold mb-2" style="font-size:14px;">@course.Name</h6>
                                    <p class="mb-1"><i class="bi bi-clock-fill text-primary"></i> @course.Duration</p>
                                    <p class="mb-1"><i class="bi bi-people-fill text-primary"></i> @course.Students Students Enrolled</p>
                                    <p class="mb-3"><i class="bi bi-laptop-fill text-primary"></i> Instructor-Led Live Sessions</p>

                                    <!-- Fees and Button – now always calls "GenAI" action -->
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <div>
                                            <p class="mb-0" style="font-size:12px;">Fees</p>
                                            <p class="mb-0">
                                                <del style="color:gray;">₹@(int.Parse(course.Fee) + 15000)</del>
                                                <strong style="font-size:18px;">₹@course.Fee</strong>
                                            </p>
                                        </div>
                                        <a href="@Url.Action("GetAI", "Edu", new { courseName = course.Name, amount = course.Fee })"
                                           style="font-size:10px; border-radius:8px; padding:10px 18px;" class="btn btn-primary">
                                            KNOW MORE
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Explore Programs CTA -->
    <div class="text-center p-4 bg-info text-white">
        <h1 class="fw-bold mb-3">Learn Programming in <span class="fw-bold">EDU<span class="brand-sub">payman</span></span></h1>
        <p class="mb-3 w-50 mx-auto">
            We believe that learning in one's native language helps in better understanding and mastery of a subject.
        </p>
        <a href="#" id="exploreAllBtn" class="btn btn-primary rounded-pill px-4">Explore All Programs</a>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Filtering Script -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const categorySelect = document.getElementById('categorySelect');
        const courseCards = document.querySelectorAll('.course-card');
        const exploreBtn = document.getElementById('exploreAllBtn');

        function filterCourses(category) {
            courseCards.forEach(card => {
                if (category === 'All' || card.dataset.category === category) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Set initial filter to Education (because option "Education" is selected)
        filterCourses('Education');

        // Dropdown change
        categorySelect.addEventListener('change', function (e) {
            filterCourses(e.target.value);
        });

        // Explore All Programs button: set dropdown to "All", show all courses, scroll to section
        exploreBtn.addEventListener('click', function (e) {
            e.preventDefault();
            categorySelect.value = 'All';
            filterCourses('All');
            document.getElementById('coursesSection').scrollIntoView({ behavior: 'smooth' });
        });
    });
</script>
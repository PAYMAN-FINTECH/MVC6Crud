                        <i class="bi bi-envelope-fill fs-1 text-success mb-2 d-block"></i>
                        <div class="h4 fw-bold">Mail Us</div>
                        <p>
                            <a href="mailto:eduinfo@payman.in" class="text-decoration-none text-dark">
                                eduinfo@payman.in

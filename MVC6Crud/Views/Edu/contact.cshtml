    Layout = "~/Views/Shared/_EduLayout.cshtml";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


<section class="contact-details my-5">
    <div class="container">
        <div class="row">

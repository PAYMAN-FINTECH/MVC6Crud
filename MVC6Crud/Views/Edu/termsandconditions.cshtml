@{
    ViewData["Title"] = "Terms & Conditions";
    Layout = "~/Views/Shared/_EduLayout.cshtml";
}

<style>
    .terms-wrapper {
        max-width: 1000px;
        margin: 40px auto;
        padding: 20px;
    }

    .terms-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .terms-header h1 {
            font-weight: 700;
            color: #0d6efd;
        }

    .effective-date {
        color: #6c757d;
        font-size: 14px;
    }

    .terms-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 25px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        transition: 0.3s ease;
        border-left: 5px solid #0d6efd;
    }

        .terms-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

        .terms-card h2 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #1c1c1c;
        }

        .terms-card p {
            font-size: 14px;
            line-height: 1.7;
            color: #555;
        }

        .terms-card ul {
            padding-left: 20px;
        }

            .terms-card ul li {
                font-size: 14px;
                margin-bottom: 6px;
                color: #444;
            }

    .intro-card {
        background: linear-gradient(135deg, #0d6efd, #0047ab);
        color: white;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 6px 25px rgba(13, 110, 253, 0.3);
        margin-bottom: 30px;
    }

    .footer-links {
        margin-top: 40px;
        text-align: center;
        font-size: 14px;
    }

        .footer-links a {
            text-decoration: none;
            margin: 0 8px;
            color: #0d6efd;
            font-weight: 500;
        }

            .footer-links a:hover {
                text-decoration: underline;
            }
</style>

<div class="terms-wrapper">

    <div class="terms-header">
        <h1>Terms & Conditions</h1>
        <div class="effective-date">
            Effective as of October 1st, 2025

                        <p>Discount: ₹@ViewBag.DiscountedAmount</p>
                        <h4>Total: ₹@ViewBag.FinalAmount</h4>
                        <button class="btn btn-success w-100" id="payBtn">
                            Proceed to Pay
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

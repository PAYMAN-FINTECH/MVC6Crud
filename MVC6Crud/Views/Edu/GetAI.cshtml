<!-- ===== HERO SECTION (YOUR UI UNCHANGED) ===== -->
<section style="background-color:#0a2a66; color:white; padding:60px 0;">
    <div class="container d-flex flex-column flex-md-row align-items-center">
        <div class="col-md-6">
            <h6 class="text-warning fw-bold">MICRO DEGREE</h6>
            <h1 class="fw-bold">@ViewBag.CourseName</h1>
            <p>Become a professional @ViewBag.CourseName in just 12 weeks!</p>
            <div class="mb-3 p-2 bg-primary text-white rounded" style="display:inline-block;">
                Application closes on <strong>@DateTime.Now.AddMonths(1).ToString("dd MMM yyyy")</strong>
            </div>
            <div class="d-flex gap-3 mt-3">
                <a href="#courseSection" class="btn btn-outline-light">KNOW MORE</a>
                <!-- 👉 MODIFIED: Ask login before enroll -->
                <a href="#enrollSection"
                   onclick="checkLoginBeforeEnroll(event)"
                   class="btn btn-primary">
                    ENROLL NOW
                </a>
            </div>
            <p class="text-light mt-2">Seats Remaining: <strong>13</strong></p>
        </div>
        <div class="col-md-6 text-center">
            <img src="~/images/edu/genai/md-landing-img.webp"
                 alt="Course Preview" class="img-fluid">
        </div>
    </div>
</section>
<!-- ========== YOU PROVIDED THIS ENTIRE BLOCK — KEPT EXACTLY SAME ========== -->

                    <span>Application closes on: <strong class="text-primary">@DateTime.Now.AddMonths(1).ToString("dd MMM yyyy")</strong></span>
                    <p class="mb-0" style="font-size:13px;">Get instant access to pre-course material!</p>
                </div>
                <form id="userForm">
                    <div class="mb-3">
                        <label class="form-label">Full Name *</label>
                        <input type="text"
                               id="fullName"
                               name="FullName"
                               class="form-control"
                               value="@userName"
                               placeholder="Your full name"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email *</label>
                        <input type="email"
                               id="email"
                               name="Email"
                               class="form-control"
                               value="@userEmail"
                               placeholder="abc@gmail.com"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">WhatsApp Number *</label>
                        <input type="text"
                               id="whatsapp"
                               name="WhatsAppNumber"
                               class="form-control"
                               value="@userPhone"
                               placeholder="Enter your number"
                               required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Select Payment Gateway *</label>
                        <select id="gateway" class="form-control" required>
                            <option value="">-- Select Gateway --</option>
                            <option value="JioPay">JioPay</option> 
                            <option value="cashfree">Cashfree</option>
                            <option value="paytm">Paytm</option>
                            <option value="razorPay">Razor Pay</option>
                        </select>
                    </div>
                    <!-- 👉 MODIFIED: Next checks login -->
                    <button type="button" class="btn btn-primary w-100" id="nextBtn">
                        Next
                    </button>

    .curriculum-section {
        background: #f0f8ff;
        padding: 40px;
        border-radius: 20px;
        margin-top: 30px;
    }

    .curriculum-title {
        background: #0d1b3e;
        color: #fff;
        padding: 15px;
        border-radius: 12px;
        font-size: 1.8rem;
        font-weight: bold;
    }

    .session-info {
        background: #d6ebff;
        padding: 15px;
        border-radius: 12px;
        margin: 20px 0;
        font-size: 1rem;
    }

    .module-card {
        background: #fff;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .section-title {
        background: #0d1b3e;
        color: #fff;
        padding: 15px;
        border-radius: 12px;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .icon-box {
        text-align: center;
        padding: 20px;
    }

        .icon-box i {
            font-size: 2rem;
            color: #0d6efd;
        }

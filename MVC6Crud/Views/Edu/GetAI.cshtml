@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_EduLayout.cshtml";
    // ===== NEW: Read session for auto-fill =====
    var userName = Context.Session.GetString("UserName");
    var userEmail = Context.Session.GetString("Email");
    var userPhone = Context.Session.GetString("UserPhone");
    bool isLoggedIn = !string.IsNullOrEmpty(userName);
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

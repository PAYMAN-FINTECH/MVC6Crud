                                    $('#Loader').hide();

                                },
                                prefill: {
                                    // name: username,
                                    email: "jurrajanardhan@gmail.com",
                                },
                                theme: {
                                    color: '#2222d6'
                                },
                                method: {
                                    "card": true, // Allow card payments only
                                    "netbanking": false,
                                    "upi": false,
                                    "wallet": false
                                }
                            };
                            const rzp1 = new window.Razorpay(options);
                            rzp1.open();
                        }
                        $('#Loader').show();
                    },
                    error: function () { alert('A error'); }
                });
            }

            // $.ajax({
            //     url: '/CCBill/MakePayment',
            //     method: 'POST',
            //     contentType: 'application/json',
            //     data: JSON.stringify({
            //         billerId: billerId,
            //         amount: amount,
            //         mobile: mobile
            //     }),
            //     success: function (res) {
            //         if (res.success) {
            //             $('#paymentMessage').html(`<span class="text-success">${res.message}</span>`);
            //         } else {


<div class="row col-md-12">
    <div class="col-md-6">
        <div class="container">
            <h2>Reset Password</h2>
            <br />
            <div class="row">
                @if (TempData["validPass"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @TempData["validPass"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="jumbotron">
                    <form role="form" asp-action="ResetPassword" asp-controller="PayMan" method="post">

                        <label class="text-danger">@ViewBag.message</label>
                        <div class="form-group col-8">
                            <label for="OldPassword"><i class="fa fa-user p-2"></i><strong>Email</strong></label>
                            <input type="email" name="email" autocomplete="off" required class="form-control input-sm" placeholder="Eter email">
              
                        </div>
                        <br />
                        <input type="submit" value="Reset" class="btn btn-primary">
                    </form>
                </div>


            </div>
        </div>

    </div>
    <div class="col-md-6">
        <div class="img-responsive">
            <img src="~/images/rrrrrrr.jpeg" style="width:100%" />

        </div>
    </div>
</div>



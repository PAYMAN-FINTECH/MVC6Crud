<style>
    .input-group-custom {
        position: relative;
        margin-bottom: 20px;
    }

        /* Label styling */
        .input-group-custom label {
            position: absolute;
            top: 50%;
            left: 12px;
            transform: translateY(-50%);
            background: white;
            padding: 0 5px;
            font-size: 16px;
            color: #999;
            transition: 0.3s;
            pointer-events: none;
        }

    /* Input field styling */
    .input-custom {
        width: 100%;
        padding: 12px 10px;
        font-size: 16px;
        border: 2px solid #ccc;
        border-radius: 5px;
        outline: none;
        transition: 0.3s;
        background-color: white;
    }

        /* Move label when input is focused or has content */
        .input-custom:focus + label,
        .input-custom:not(:placeholder-shown) + label {
            top: 0;
            left: 10px;
            font-size: 14px;
            color: blue;
        }

        /* Error styling */
        .input-custom.is-invalid {
            border-color: red;
        }

    .text-danger {
        font-weight: bold;
        display: none; /* Hidden by default */
    }

    /* Fetch Bill button */
    .btn-primary {
        background-color: #0047ab;
        border: none;
        padding: 12px;
        font-size: 18px;
        border-radius: 5px;
        width: 100%;
    }

        .btn-primary:hover {
            background-color: #003693;
        }




    body {
        background-color: #f8f9fa;
    }

    .feature-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        text-align: center;
        border-radius: 10px;
        border: 2px solid transparent;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        background: white;
        padding: 10px;
        transition: all 0.3s ease-in-out;
    }

        .feature-box:hover {
            border: 2px solid #007bff;
            transform: scale(1.05);
        }

    .feature-icon {
        font-size: 30px;
        color: #007bff;
        transition: color 0.3s ease-in-out;
    }

    /* .feature-box:hover .feature-icon {
                color: white;
            } */

    .feature-title {
        margin-top: 10px;
        font-size: 10px;
        color: #333;
        font-weight: bold;
        transition: color 0.3s ease-in-out;
    }

    .feature-box:hover .feature-title {
        color: #007bff;
    }

</style>

<h2>Fast Tag</h2>

<div class="input-group mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="Search" value="@Model.SearchTerm">
    <button class="btn btn-outline-secondary" id="searchButton">
        <i class="fas fa-search"></i>
    </button>
</div>

<div class="row">
    @foreach (var biller in Model.Billers)
    {

        <div class="col-md-4">
            <div class="card mb-3">
                <img src="@biller.IconUrl" class="card-img-top" alt="@biller.BillerName" data-biller-id="@biller.BillerId" style="height: 80px; object-fit: contain;" data-bs-toggle="offcanvas" data-bs-target="#creditCardSidebar">
                <div class="card-body text-center">
                    <p class="card-text">@biller.BillerName</p>
                </div>
            </div>
        </div>
    }
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="creditCardSidebar">
    <div class="offcanvas-header">
        <h5 class="fw-bold text-primary">FastTag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="text-center mb-3">
            <img id="creditCardLogo" src="https://via.placeholder.com/50" alt="Selected Card Logo" style="height: 50px;">
           @*  <h6 id="creditCardName" class="fw-bold">Select a Card</h6> *@
        </div>

        <input type="hidden" id="billerId1">
        <input type="hidden" id="walletmode">
        <input type="hidden" id="ExRefId">
        <input type="hidden" id="avlAmount" value="@Model.AvlAmount">
        <input type="hidden" id="InstanPaYAvlBal" value="@Model.InstanPaYAvlBal">
        <input type="hidden" id="param1">
        <input type="hidden" id="param2">

        <form id="creditCardForm">
            <!-- Last 4 Digits -->
            <div class="input-group-custom">
                <input type="text" id="creditCardNumber" class="form-control input-custom" placeholder=" " required maxlength="4">
                <label for="creditCardNumber">Please enter Vehicle Number</label>
                <div class="text-danger">Please enter Vehicle Number</div>
            </div>

            <!-- Mobile Number -->
            <div class="input-group-custom">
                <input type="number" id="mobileNumber" class="form-control input-custom" placeholder=" " required maxlength="10">
                <label for="mobileNumber">Vehicle Holder Mobile Number</label>
                <div class="text-danger">Vehicle Holder Number Field</div>
            </div>

            <!-- Customer Mobile -->
            <div class="input-group-custom">
                <input type="number" id="customerMobile" class="form-control input-custom" placeholder=" " required maxlength="10">
                <label for="customerMobile">Customer Mobile</label>
                <div class="text-danger">Customer Mobile Field</div>
            </div>

            <button type="submit" id="btnFetchBill" class="btn btn-primary fw-bold">Fetch Bill</button>

            <!-- Amount input (Initially Hidden and Not Required) -->
            <div id="amountContainer" class="input-group-custom mt-3" style="display: none;">
                <input type="number" id="amount" name="amount" class="form-control input-custom" placeholder=" ">
                <label for="amount">Enter Amount</label>
                <div class="text-danger">Amount is required</div>
            </div>


            <div id="billDetails" class="mt-3"></div>

            <!-- Proceed Button (Initially Hidden) -->
            <button type="submit" id="btnProceed" class="btn btn-primary fw-bold mt-2" style="display: none;">Proceed</button>
        </form>


    </div>
</div>



@model ChangePassword

<div class="row col-md-12">
    <div class="col-md-6">
        <div class="container">
            <h2>Change Password</h2>
            <br />
            <div class="row">
                @if (TempData["validPass"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @TempData["validPass"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                <div class="jumbotron">
                    <form role="form" asp-action="ChangePassword" asp-controller="PayMan" method="post">

                        <label class="text-danger">@ViewBag.message</label>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group col-8">
                            <label for="OldPassword"><i class="fa fa-user p-2"></i><strong>Old Password</strong></label>
                            <input type="oldPassword" name="OldPassword" asp-for="OldPassword" autocomplete="off" required class="form-control input-sm" placeholder="Old Password">
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group col-8">
                            <label for="NewPassword"><i class="fa fa-user p-2"></i><strong>New Password</strong></label>
                            <input type="newPassword" name="NewPassword" asp-for="NewPassword" autocomplete="off" required class="form-control input-sm" placeholder="New Password">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>

                        </div>
                        <div class="form-group col-8">
                            <label for="OldPassword"><i class="fa fa-user p-2"></i><strong>Confirm Password</strong></label>
                            <input type="confirmPassword" name="ConfirmPassword" asp-for="ConfirmPassword" autocomplete="off" required class="form-control input-sm" placeholder="Confirm Password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <br />
                        <input type="submit" value="Change Password" class="btn btn-primary">
                    </form>
                </div>


            </div>
        </div>

    </div>
    <div class="col-md-6">
        <div class="img-responsive">
            <img src="~/images/rrrrrrr.jpeg" style="width:100%" />

        </div>
    </div>
</div>



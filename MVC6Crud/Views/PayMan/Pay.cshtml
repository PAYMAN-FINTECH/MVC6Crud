@model PayPayment

<div class="row col-md-12">
    <div class="col-md-6">
        <div class="container">
            <h2>Pay Payment</h2>
            <br />
            <div class="row">

                <div class="jumbotron">
                    <form role="form" id="form1">

                        <label class="text-danger">@ViewBag.message</label>

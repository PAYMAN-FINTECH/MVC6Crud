        addInput(form, 'amount', amount);
        addInput(form, 'productinfo', productInfo);
        addInput(form, 'firstname', firstName);
        addInput(form, 'phone', phone);
        addInput(form, 'email', email);
        addInput(form, 'surl', surl);
        addInput(form, 'furl', furl);
        addInput(form, 'service_provider', 'payu_paisa');
        addInput(form, 'hash', hash);

        document.body.appendChild(form);
        form.submit();
    }

    function addInput(form, name, value) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        form.appendChild(input);
    }


    function generateTxnid() {
        const randomStr = `${Math.random()}${Date.now()}`;
        console.log("randomStr: " + randomStr);
        debugger;
        const hash = generateHash512(randomStr);
        console.log("hash: " + hash);
        debugger;
        return hash.substring(0, 20);
    }

    function generateHash512(text) {
        console.log("text: " + text);
        debugger;
        const encoder = new TextEncoder();
        const data = encoder.encode(text);
        const hashBuffer = crypto.subtle.digest('SHA-512', data);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        return hashHex;
    }

    function formatDateInIST() {
        // Create a new Date object and convert it to IST
        let currentdate = new Date();

        // Calculate the time offset for IST (UTC+5:30)
        let offset = 5.5 * 60; // 5 hours 30 minutes in minutes
        let ISTTime = new Date(currentdate.getTime() + (offset * 60 * 1000));

        // Extract the required date and time components
        let month = (ISTTime.getMonth() + 1).toString().padStart(2, '0');
        let day = ISTTime.getDate().toString().padStart(2, '0');
        let year = ISTTime.getFullYear();

        let hours = ISTTime.getHours();
        let minutes = ISTTime.getMinutes().toString().padStart(2, '0');
        let seconds = ISTTime.getSeconds().toString().padStart(2, '0');

        let ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12;
        hours = hours ? hours : 12; // the hour '0' should be '12'
        hours = hours.toString().padStart(2, '0');

        // Return the formatted date and time string
        return `${month}/${day}/${year} ${hours}:${minutes}:${seconds} ${ampm}`;
    }


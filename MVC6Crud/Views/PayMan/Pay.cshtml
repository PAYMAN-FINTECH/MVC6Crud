                            <span asp-validation-for="EnterCustomerNumber" class="text-danger"></span>
                        </div>
                        <br />
                        <div class="form-group col-8">
                            <label for="Amount"><i class="fa fa-inr p-2"></i><strong>Amount</strong></label>
                            <input type="number" id="amount" name="Amount" asp-for="Amount" required autocomplete="off" class="form-control input-sm" placeholder="Amount">
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <br />
                        <div class="form-group col-8">
                            <label for="SelectPaymentGateWay"><i class="fa fa-address-card-o p-2" aria-hidden="true"></i><strong>Select Payment GateWay</strong></label>
                            <select id="drpEmpList" class="form-control" asp-for="SelectPaymentGateWay">
                                <option value="">--Select--</option>
                                @* <option value="2">Normal Cards</option>
 *@
                                @* @if (Model.IsSrrEnable == true)
                                {
                                    <option value="6">Normal /Master Cards</option>
                                    <option value="8">Normal /Master Cards</option>
                                } *@
                                @* <option value="3">Bussiness/Commercial Cards</option> *@
                                @* <option value="7">AirPay</option> *@
                                @*  <option value="4">PayU</option> *@
                                @* <option value="5">PineLab(UAT)</option> *@

                                @if (Model.EaseBuzzEnable == true)
                                {
                                    <option value="9">Ease buzz</option>
                                }
                                else
                                {
                                <option value="8">Ease buzz</option>
                                }


                            </select>
                        </div>
                        <br />
                        <input type="hidden" id="userName" name="UserName" asp-for="UserName" />
                        <input type="hidden" id="email" name="Email" asp-for="Email" />
                        <input type="hidden" id="phone" name="Phone" asp-for="phone" />


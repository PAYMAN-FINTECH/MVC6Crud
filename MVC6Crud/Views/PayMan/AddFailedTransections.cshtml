@model AddFailedrecords

<div class="row col-md-12">

    <div class="container">
        <div class="col-md-6">

            <h4>Add Failed Transections</h4>
            <br />
            <div class="row p-2">

                <div class="jumbotron">
                    <form role="form" method="post" asp-action="AddFailedTransections" asp-controller="PayMan">
                        <div class="form-group col-6">
                            <label for="OrderId"><strong>order Id</strong></label>
                            <input type="text" name="OrderId" asp-for="OrderId" required autocomplete="off" class="form-control input-sm" placeholder="Order Id">
                            <span asp-validation-for="OrderId" class="text-danger"></span>
                        </div>

                        <div class="form-group col-6">
                            <label for="OrderRefIf"><strong>Order refId</strong></label>
                            <input type="text" name="OrderRefIf" asp-for="OrderRefIf" required autocomplete="off" class="form-control input-sm" placeholder="Order Ref Id">
                            <span asp-validation-for="OrderRefIf" class="text-danger"></span>
                        </div>
                        <div class="form-group col-6">
                            <label for="Cardno"><strong>Card Number</strong></label>
                            <input type="text" name="Cardno" asp-for="Cardno" required autocomplete="off" class="form-control input-sm" placeholder="Card Number">
                            <span asp-validation-for="Cardno" class="text-danger"></span>
                        </div>
                        <div class="form-group col-6">
                            <label for="Amount"><strong>Amount</strong></label>
                            <input type="text" name="Amount" asp-for="Amount" required autocomplete="off" class="form-control input-sm" placeholder="Amount">
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="form-group col-6">
                            <label for="TxnType"><strong>Gate Way</strong></label>
                            <select id="drpEmpList" class="form-control" required asp-for="selectedGateway">
                                <option value="">--Select--</option>
                                <option value="2">Razor Pay</option>
                                <option value="3">Razor Pay Master</option>
                                <option value="4">Lyra</option>
                                <option value="5">RazorPay srr Visa</option>
                                <option value="6">RazorPay Srr Master</option>
                                <option value="7">RazorPay Srr Rupay</option>
                                <option value="8">EaseBuzz</option>
                                <option value="9">EaseBuzz master</option>
                                <option value="10">EaseBuzz1</option>
                                <option value="11">EaseBuzz master1</option>
                            </select>
                        </div>
                        <div class="form-group col-6">
                            <label for="SelectBank"><strong>Select User</strong></label>
                            <select id="dropdown" class="form-control" asp-for="SelectedOption" required asp-items="Model.Options"></select>
                        </div>
                        <div class="form-group col-6">
                            <label for="Cardtype"><strong>Card Type</strong></label>
                            <select id="drpEmpList1" class="form-control" required asp-for="Cardtype">
                                <option value="">--Select--</option>
                                <option value="Visa">Visa</option>
                                <option value="MasterCard">MasterCard</option>
                                <option value="Rupay">Rupay</option>
                            </select>
                        </div>

                        <div class="row" style="text-align:right">
                            <div class="form-group col-6">
                            </div>
                            <div class="form-group col-6">
                                <input type="submit" value="Save" class="btn btn-primary btn-sm">
                            </div>
                        </div>
                    </form>
                </div>


            </div>
        </div>
    </div>
</div>
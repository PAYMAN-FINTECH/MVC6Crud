// PAYMAN AIRPAY PAYMENT
// CURRENT TAB ONLY
// ========================================================
async function payWithAirpay(amount,orderId) {

    const button =
        document.getElementById("btnAirpay");

    if (button) {
        button.disabled = true;
        button.innerHTML = "Processing...";
    }

    try {

        console.log("Calling AirPay Initiate API...");
        console.log("Amount:", amount);

        const response = await fetch(
            "https://edu.paymanfintech.in/Airpay/Initiate",
            {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    amount: amount,
                    orderId: orderId
                })
            }
        );

        console.log(
            "AirPay HTTP Status:",
            response.status
        );

        const responseText =
            await response.text();

        console.log(
            "AirPay Response:",
            responseText
        );

        let result;

        try {

            result =
                JSON.parse(responseText);

        }
        catch (e) {

            console.error(
                "Invalid JSON:",
                responseText
            );

            alert(
                "Invalid response received from server."
            );

            resetAirpayButton();

            return;
        }

        if (!response.ok || !result.success) {

            alert(
                result.message ||
                "Unable to initiate AirPay payment."
            );

            resetAirpayButton();

            return;
        }

        console.log(
            "AirPay Order:",
            result.orderId
        );

        console.log(
            "AirPay Payment URL:",
            result.paymentUrl
        );

        // ====================================================
        // SUBMIT AIRPAY IN CURRENT TAB
        // ====================================================

        submitAirpayForm(result);

    }
    catch (error) {

        console.error(
            "AirPay error:",
            error
        );

        alert(
            "Unable to connect to payment gateway."
        );

        resetAirpayButton();
    }
}


// ========================================================
// SUBMIT FORM TO AIRPAY - CURRENT TAB
// ========================================================
function submitAirpayForm(data) {

    console.log(
        "Preparing AirPay form..."
    );

    console.log(
        "Payment URL:",
        data.paymentUrl
    );


    // Remove old form if exists
    const oldForm =
        document.getElementById("airpayForm");

    if (oldForm) {
        oldForm.remove();
    }


    // Create form in CURRENT PAGE
    const form =
        document.createElement("form");

    form.id =
        "airpayForm";

    form.method =
        "POST";

    form.action =
        data.paymentUrl;

    // VERY IMPORTANT
    // Force current tab
    form.target =
        "_self";

    form.style.display =
        "none";


    // ====================================================
    // AIRPAY PARAMETERS
    // ====================================================

    addHiddenInput(
        form,
        "privatekey",
        data.privateKey
    );

    addHiddenInput(
        form,
        "merchant_id",
        data.merchantId
    );

    addHiddenInput(
        form,
        "encdata",
        data.encData
    );

    addHiddenInput(
        form,
        "checksum",
        data.checksum
    );

    addHiddenInput(
        form,
        "apyVer",
        "4"
    );


    // Add form to CURRENT document
    document.body.appendChild(form);


    console.log(
        "Submitting AirPay in CURRENT TAB..."
    );


    // ====================================================
    // SUBMIT
    // ====================================================

    form.submit();
}


// ========================================================
// ADD HIDDEN INPUT
// ========================================================
function addHiddenInput(
    form,
    name,
    value
) {

    const input =
        document.createElement("input");

    input.type =
        "hidden";

    input.name =
        name;

    input.value =
        value || "";

    form.appendChild(input);
}


// ========================================================
// RESET BUTTON
// ========================================================
function resetAirpayButton() {

    const button =
        document.getElementById(
            "btnAirpay"
        );

    if (button) {

        button.disabled =
            false;

        button.innerHTML =
            "Pay with AirPay";
    }
}

      

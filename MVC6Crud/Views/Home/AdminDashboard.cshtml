            };

            $.ajax({
                url: '/Home/AddPayOut',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    if (res.success) {
                        $('#addPayoutModal').modal('hide');
                        $('#payoutForm')[0].reset();
                        location.reload(); // Refresh page
                        showToast("PayOut added successfully", 'success');
                    } else {
                        showToast('Failed to add payout', 'danger');
                    }
                },
                error: function () {
                    showToast('Server error while adding payout', 'danger');
                }
            });
        });


        function formatDate(dateStr) {
            if (!dateStr) return "NA";
            const d = new Date(dateStr);
            const options = { day: '2-digit', month: '2-digit', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true };
            return d.toLocaleString('en-IN', options).replace(',', '');
        }

        $(document).on('click', '.refund-btn', function () {
            const payoutId = $(this).data('id');

            if (!confirm("Are you sure you want to refund this payout?")) return;

            $.ajax({
                url: '/Home/RefundPayout',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ id: payoutId }),
                success: function (res) {
                    if (res.success) {
                         showToast("Refund successful", 'success');

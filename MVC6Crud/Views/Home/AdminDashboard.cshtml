@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Quick Stats -->
<div class="container py-4">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="col-md-6">
        <label class="form-label">User</label>
        <select class="form-select" id="userDropdown1" required></select>
    </div>

    <!-- Date Range -->
    <!-- Date Range + Action Buttons -->
    <div class="row align-items-end mb-3">
        <div class="col-md-3">
            <label>Start Date</label>
            <input type="date" class="form-control" id="startDate" />
        </div>
        <div class="col-md-3">
            <label>End Date</label>
            <input type="date" class="form-control" id="endDate" />
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-primary btn-sm me-2" onclick="filterByDate()">
                <i class="bi bi-funnel-fill"></i> Filter
            </button>
            <button class="btn btn-success btn-sm me-2" onclick="$('#addPayInModal').modal('show'); loadDropdowns();">
                <i class="bi bi-plus-circle"></i> Add PayIn
            </button>
            <button class="btn btn-danger btn-sm" onclick="addPayOut()">
                <i class="bi bi-plus-circle"></i> Add PayOut
            </button>
            <button class="btn btn-primary btn-sm" onclick="GetInvoicesByDate()">
                <i class="bi bi-plus-circle"></i> Get Inovices
            </button>
         

        </div>
    </div>


    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <i class="bi bi-people-fill fs-3 float-end"></i>
                    <h5 class="card-title">Total Users</h5>
                    <h3 id="userCount">0</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <i class="bi bi-arrow-down-circle fs-3 float-end"></i>
                    <h5 class="card-title">Total PayIn</h5>
                    <h3 id="totalPayIn">₹0</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-danger shadow-sm">
                <div class="card-body">
                    <i class="bi bi-arrow-up-circle fs-3 float-end"></i>
                    <h5 class="card-title">Total PayOut</h5>
                    <h3 id="totalPayOut">₹0</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card text-white bg-secondary shadow-sm">
                <div class="card-body">
                    <i class="bi bi-wallet2 fs-3 float-end"></i>
                    <h5 class="card-title">Total Balance</h5>
                    <h3 id="totalBalance">₹0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Toggles -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Service Access Toggles</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="togglePayIn">
                        <label class="form-check-label" for="togglePayIn">PayIn Access</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="togglePayOut">
                        <label class="form-check-label" for="togglePayOut">PayOut Access</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleCCBill">
                        <label class="form-check-label" for="toggleCCBill">CC Bill Access</label>
                    </div>
                </div>

                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleInstantPay">
                        <label class="form-check-label" for="toggleInstantPay">Instant Pay Access</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleBillAvenue">
                        <label class="form-check-label" for="toggleBillAvenue">Bill Avenue Access</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleEasebuzz1">
                        <label class="form-check-label" for="toggleEasebuzz1">Easebuzz1</label>
                    </div>
                </div>

                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleEasebuzz2">
                        <label class="form-check-label" for="toggleEasebuzz2">Easebuzz2</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleEduCashfree">
                        <label class="form-check-label" for="toggleEduCashfree">EduCashfree</label>
                    </div>
                </div>

                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="togglePineLab">
                        <label class="form-check-label" for="togglePineLab">Pine Lab</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleCSbBank">
                        <label class="form-check-label" for="toggleCSbBank">CSB Bank</label>
                    </div>
                </div>

                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleTravelvegaah">
                        <label class="form-check-label" for="toggleTravelvegaah">Vegaah</label>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="toggleEduRozerpay">
                        <label class="form-check-label" for="toggleEduRozerpay">RozorPay Edu</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="accordion" id="adminAccordion">

        <!-- All Users -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingUsers">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUsers" aria-expanded="true" aria-controls="collapseUsers">
                    All Users
                </button>
            </h2>
            <div id="collapseUsers" class="accordion-collapse collapse show" aria-labelledby="headingUsers" data-bs-parent="#adminAccordion">
                <div class="accordion-body">
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Phone</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>App Pin</th>
                                <th>Web Pass</th>
                                <th>Pay In</th>
                                <th>PayIn comm</th>
                                <th>Pay Out</th>
                                <th>Avl Bal</th>
                            </tr>
                        </thead>
                        <tbody id="usersTable">
                            <!-- Loaded via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PayIns -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingPayIns">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePayIns" aria-expanded="false" aria-controls="collapsePayIns">
                    PayIns
                </button>
            </h2>
            <div id="collapsePayIns" class="accordion-collapse collapse" aria-labelledby="headingPayIns" data-bs-parent="#adminAccordion">
                <div class="accordion-body">
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Txn ID</th>
                                <th>Phone</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody id="payInsTable">
                            <!-- Loaded via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PayOuts -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingPayOuts">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePayOuts" aria-expanded="false" aria-controls="collapsePayOuts">
                    PayOuts
                </button>
            </h2>
            <div id="collapsePayOuts" class="accordion-collapse collapse" aria-labelledby="headingPayOuts" data-bs-parent="#adminAccordion">
                <div class="accordion-body">
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Ref ID</th>
                                <th>Phone</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Mode</th>
                                <th>Date</th>
                                <th>Refund</th> <!-- Refund column -->
                            </tr>
                        </thead>
                        <tbody id="payOutsTable">
                            <!-- Loaded via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <!-- Add PayIn Modal -->
    <div class="modal fade" id="addPayInModal" tabindex="-1" aria-labelledby="addPayInModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="addPayInForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addPayInModalLabel">Add PayIn</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Order RefId</label>
                            <input type="text" class="form-control" id="orderRefId" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Card Number</label>
                            <input type="text" class="form-control" id="cardNumber" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount</label>
                            <input type="text" class="form-control" id="amount" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">User</label>
                            <select class="form-select" id="userDropdown" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gateway</label>
                            <select class="form-select" id="gatewayDropdown" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Card</label>
                            <select class="form-select" id="cardDropdown" required></select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Submit</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add PayOut Modal -->
    <div class="modal fade" id="addPayoutModal" tabindex="-1" aria-labelledby="addPayoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form id="payoutForm" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add PayOut</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Order Ref ID</label>
                        <input type="text" class="form-control" id="payoutOrderRefId" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Account Holder Name</label>
                        <input type="text" class="form-control" id="payoutHolderName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bank</label>
                        <select class="form-select" id="payoutBank" required></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Account Number</label>
                        <input type="text" class="form-control" id="payoutAccountNumber" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">User</label>
                        <select class="form-select" id="payoutUser" required></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Amount</label>
                        <input type="number" class="form-control" id="payoutAmount" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Submit</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>



</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.14/jspdf.plugin.autotable.min.js"></script>

    <script>
        $(function () {
            const today = new Date().toISOString().split('T')[0];
             $('#startDate').val(today);
             $('#endDate').val(today);

           // loadDashboard();
            loadToggles();
            filterByDate(); // load default data
             loadUsers();
             loadDropdowns();
            // loadPayIns();
            // loadPayOuts();

         $('.form-check-input').change(function () {
            const feature = $(this).attr("id").replace("toggle", "");
            const enabled = $(this).is(":checked");

            $.ajax({
                url: '/Home/UpdateFeatureAccess',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ feature: feature, enabled: enabled }),
                success: function (res) {
                    // Show success toast
                    showToast(`Feature "${feature}" has been ${enabled ? 'enabled' : 'disabled'}.`, 'success');
                },
                error: function () {
                    showToast("Failed to update feature access.", 'danger');
                }
            });
        });

        });



        function addPayOut() {
            // Load dropdown values when modal is triggered
            loadPayoutUsers();
            loadPayoutBanks();

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('addPayoutModal'));
            modal.show();
        }

        function loadPayoutUsers() {
            $.getJSON('/Home/GetUsers', function (data) {
                const userSelect = $('#payoutUser');
                userSelect.empty().append('<option value="">Select User</option>');
                data.forEach(u => userSelect.append(`<option value="${u.phone}">${u.name} (${u.phone})</option>`));
            });
        }

        function loadPayoutBanks() {
            $.getJSON('/Home/GetBanks', function (data) {
                const bankSelect = $('#payoutBank');
                bankSelect.empty().append('<option value="">Select Bank</option>');
                data.forEach(b => bankSelect.append(`<option value="${b.name}">${b.name}</option>`));
            });
        }

        function loadToggles() {
            $.getJSON("/Home/GetFeatureAccess", function (res) {
                if (res.success) {
                    const a = res.data;
                    $('#togglePayIn').prop('checked', a.payIn);
                    $('#togglePayOut').prop('checked', a.payOut);
                    $('#toggleCCBill').prop('checked', a.ccBill);
                     $('#toggleInstantPay').prop('checked', a.instantPay);
                     $('#toggleBillAvenue').prop('checked', a.billAvenue);

                     $('#toggleEasebuzz1').prop('checked', a.easebyzz1);
                     $('#toggleEasebuzz2').prop('checked', a.easebuzz2);
                     $('#toggleEduCashfree').prop('checked', a.eduCashfree);

                     $('#togglePineLab').prop('checked', a.pineLab);
                     $('#toggleCSbBank').prop('checked', a.csbBank);

                     $('#toggleEduRozerpay').prop('checked', a.rozorpayedu);
                     $('#toggleTravelvegaah').prop('checked', a.edutrav);
                }
            });
        }

        function loadUsers() {
            $.getJSON("/Home/GetAllUsers", function (res) {
                $('#usersTable').empty();
                debugger;
                res.data.forEach(u => {
                    $('#usersTable').append(`<tr><td>${u.userPhone}</td><td>${u.name}</td><td>${u.email}</td><td>${u.userPin}</td><td>${u.webPass}</td><td>${u.payIn}</td><td>${u.payIncomm}</td><td>${u.payOut}</td><td>${u.walletBalance}</td></tr>`);
                });
            });
        }


        function filterByDate() {
            const start = $('#startDate').val();
            const end = $('#endDate').val();

            $.ajax({
                url: '/Home/GetDashboardStats',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ startDate: start, endDate: end }),
                success: function (res) {
                    $('#userCount').text(res.data.totalUsers);
                    $('#totalPayIn').text('₹' + res.data.totalPayIns);
                    $('#totalPayOut').text('₹' + res.data.totalPayOuts);
                    $('#totalBalance').text('₹' + res.data.totalBalance);
                }
            });

            $.getJSON('/Home/GetAllPayIns?startDate=' + start + '&endDate=' + end, function (res) {
                $('#payInsTable').empty();
                res.data.forEach(p => {
                    $('#payInsTable').append(`<tr>
                        <td>${p.transactionId}</td>
                        <td>${p.userPhone}</td>
                        <td>₹${p.amount}</td>
                        <td>${p.status}</td>
                        <td>${formatDate(p.date)}</td>
                    </tr>`);
                });
            });

            $.getJSON('/Home/GetAllPayOuts?startDate=' + start + '&endDate=' + end, function (res) {
                $('#payOutsTable').empty();
                res.data.forEach(p => {
                     const refundBtn = `<button class="btn btn-sm btn-danger refund-btn" data-id="${p.id}">Refund</button>`;
                     const rdfSuccess = `<button class="btn btn-sm btn-success readonly refund-btn" disabled data-id="${p.id}">Refunded</button>`;

                     const result = p.result === "Refunded" ? rdfSuccess : refundBtn;

                    $('#payOutsTable').append(`<tr>
                        <td>${p.refId}</td>
                        <td>${p.userPhone}</td>
                        <td>₹${p.amount}</td>
                        <td>${p.status}</td>
                        <td>${p.mode}</td>
                        <td>${formatDate(p.date)}</td>
                        <td>${result}</td>
                    </tr>`);
                });
            });
        }

        function loadDropdowns() {
            // Users dropdown
            $.getJSON('/Home/GetUsers', function (data) {
                const userSelect = $('#userDropdown');
                userSelect.empty().append('<option value="">-- Select User --</option>');
                data.forEach(u => userSelect.append(`<option value="${u.phone}">${u.name} (${u.phone})</option>`));

                const userSelect1 = $('#userDropdown1');
                userSelect1.empty().append('<option value="">-- Select User --</option>');
                data.forEach(u => userSelect1.append(`<option value="${u.phone}">${u.name} (${u.phone})</option>`));
            });

            // Gateway dropdown
            $.getJSON('/Home/GetGateways', function (data) {
                const gatewaySelect = $('#gatewayDropdown');
                gatewaySelect.empty().append('<option value="">-- Select Gateway --</option>');
                data.forEach(g => gatewaySelect.append(`<option value="${g.id}">${g.name}</option>`));
            });

            // Card dropdown
            $.getJSON('/Home/GetCards', function (data) {
                const cardSelect = $('#cardDropdown');
                cardSelect.empty().append('<option value="">-- Select Card --</option>');
                data.forEach(c => cardSelect.append(`<option value="${c.number}">${c.number}</option>`));
            });
        }


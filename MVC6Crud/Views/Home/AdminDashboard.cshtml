        $('#addPayInForm').submit(function (e) {
            e.preventDefault();

            const payload = {
                orderRefId: $('#orderRefId').val().trim(),
                cardNumber: $('#cardNumber').val().trim(),
                amount: $('#amount').val().trim(),
                userPhone: $('#userDropdown').val(),
                gatewayId: $('#gatewayDropdown').val(),
                card: $('#cardDropdown').val()
            };

            // Validate
            if (!payload.orderRefId || !payload.cardNumber || !payload.userPhone || !payload.gatewayId || !payload.card) {
                alert("Please fill all required fields.");
                return;
            }

            $.ajax({
                url: '/Home/AddPayIn',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        $('#addPayInModal').modal('hide');
                        $('#addPayInForm')[0].reset();
                        location.reload(); // Refresh page
                        showToast("Added PayIn successfully", 'success');
                    } else {
                        alert("Failed to save PayIn: " + (res.message || "Unknown error"));
                    }
                },
                error: function () {
                    alert("Something went wrong while saving.");
                }
            });
        });


        $('#payoutForm').submit(function (e) {
            e.preventDefault();

            const model = {
                OrderRefId: $('#payoutOrderRefId').val().trim(),
                AccountHolderName: $('#payoutHolderName').val().trim(),
                Bank: $('#payoutBank').val(),
                AccountNumber: $('#payoutAccountNumber').val().trim(),

@model MVC6Crud.Models.PaymanWeb.BeneficiaryListModel
@{
    ViewData["Title"] = "Passbook";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* ===== Brand Colors & Base ===== */
    :root {
        --navy: #0a2540;
        --cyan: #00b4d8;
        --navy-light: #1a3b5c;
        --gray-bg: #f8fafc;
        --success-light: #d1fae5;
        --success-dark: #065f46;
        --danger-light: #fee2e2;
        --danger-dark: #991b1b;
    }

    body {
        background-color: #f5f7fa;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .page-title {
        color: var(--navy);
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    /* ===== Filter Card ===== */
    .filter-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        margin-bottom: 2rem;
        border: 1px solid #eef2f6;
    }

    .filter-label {
        font-weight: 600;
        color: var(--navy);
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: var(--cyan);
            box-shadow: 0 0 0 3px rgba(0,180,216,0.2);
            outline: none;
        }

    /* ===== Buttons ===== */
    .btn-navy {
        background-color: var(--navy);
        color: white;
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-navy:hover {
            background-color: var(--navy-light);
            transform: translateY(-2px);
            box-shadow: 0 8px 15px -5px rgba(10,37,64,0.2);
            color: white;
        }

    .btn-cyan {
        background-color: var(--cyan);
        color: white;
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-cyan:hover {
            background-color: #0096b4;
            transform: translateY(-2px);
            box-shadow: 0 8px 15px -5px rgba(0,180,216,0.3);
            color: white;
        }

    /* ===== User Card ===== */
    .user-card {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        border: 1px solid #eef2f6;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .user-avatar {
        width: 64px;
        height: 64px;
        background: linear-gradient(145deg, var(--navy), var(--cyan));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
        font-weight: 600;
    }

    .user-info {
        flex: 1;
    }

        .user-info h5 {
            color: var(--navy);
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 1.25rem;
        }

        .user-info p {
            margin-bottom: 0.25rem;
            color: #4b5563;
        }

        .user-info strong {
            color: var(--navy);
            min-width: 60px;
            display: inline-block;
        }

    /* ===== Summary Cards ===== */
    .summary-card {
        border-radius: 1.5rem;
        border: none;
        overflow: hidden;
        transition: all 0.2s;
        height: 100%;
    }

        .summary-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 30px -10px rgba(0,0,0,0.15);
        }

        .summary-card.bg-danger {
            background: linear-gradient(145deg, #ef4444, #dc2626);
        }

        .summary-card.bg-success {
            background: linear-gradient(145deg, #10b981, #059669);
        }

        .summary-card .card-body {
            padding: 1.5rem;
            position: relative;
        }

    .summary-icon {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: 3rem;
        opacity: 0.2;
        color: white;
    }

    .summary-card h5 {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.9;
        margin-bottom: 0.75rem;
    }

    .summary-card h4 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .summary-card small {
        opacity: 0.8;
        font-size: 0.85rem;
    }

    /* ===== Transaction Table ===== */
    .table-container {
        background: white;
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.05);
        border: 1px solid #eef2f6;
    }

    .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .table thead th {
            background-color: var(--navy);
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem;
            border: none;
            white-space: nowrap;
        }

            .table thead th:first-child {
                border-top-left-radius: 1rem;
            }

            .table thead th:last-child {
                border-top-right-radius: 1rem;
            }

        .table tbody tr {
            transition: background-color 0.2s;
        }

            .table tbody tr:hover {
                background-color: #f1f5f9;
            }

        .table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #eef2f6;
            color: #334155;
            font-size: 0.95rem;
        }

    .badge-credit {
        background-color: var(--success-light);
        color: var(--success-dark);
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.8rem;
        display: inline-block;
    }

    .badge-debit {
        background-color: var(--danger-light);
        color: var(--danger-dark);
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.8rem;
        display: inline-block;
    }

    .amount-credit {
        color: #059669;
        font-weight: 600;
    }

    .amount-debit {
        color: #dc2626;
        font-weight: 600;
    }

    /* ===== Loading Spinner ===== */
    .spinner-border-sm {
        width: 1.5rem;
        height: 1.5rem;
        border-width: 0.2rem;
    }

    /* ===== Responsive ===== */
   
</style>

<div class="container py-4">
    <h1 class="page-title">Passbook</h1>

    <!-- Filter Section -->
    <div class="filter-card">
        <div class="row align-items-end g-3">
            <div class="col-md-3 col-sm-6">
                <label class="filter-label">Start Date</label>
                <input type="date" class="form-control" id="startDate" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="filter-label">End Date</label>
                <input type="date" class="form-control" id="endDate" />
            </div>
            <div class="col-md-4 col-sm-12 d-flex gap-2 justify-content-md-end">
                <button class="btn btn-navy px-4" id="btnLoad">
                    <i class="bi bi-arrow-repeat me-2"></i>Load
                </button>
                <button class="btn btn-cyan px-4" id="btnExport">
                    <i class="bi bi-download me-2"></i>Excel
                </button>
            </div>
        </div>
    </div>

    <!-- User Info Card (hidden initially) -->
    <div class="user-card" id="userCard" style="display:none;">
        <div class="user-avatar">
            <span id="userInitial"></span>
        </div>
        <div class="user-info">
            <h5 id="userName"></h5>
            <p><strong>Phone:</strong> <span id="userPhone"></span></p>
            <p><strong>Email:</strong> <span id="userEmail"></span></p>
        </div>
    </div>

    <!-- Summary Row (hidden initially) -->
    <div class="row mb-4" id="summaryRow" style="display:none;">
        <div class="col-md-6 mb-3">
            <div class="summary-card bg-danger text-white shadow-sm">
                <div class="card-body">
                    <i class="bi bi-arrow-up-circle summary-icon"></i>
                    <h5>Total Paid</h5>
                    <h4 id="totalPaid">₹0</h4>
                    <small><span id="totalPaidCount">0</span> transactions</small>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="summary-card bg-success text-white shadow-sm">
                <div class="card-body">
                    <i class="bi bi-arrow-down-circle summary-icon"></i>
                    <h5>Total Received</h5>
                    <h4 id="totalReceived">₹0</h4>
                    <small><span id="totalReceivedCount">0</span> transactions</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table" id="txnTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Mode</th>
                        <th>Name</th>
                        <th>UPI Ref</th>
                        <th>Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="txnBody">
                    <tr><td colspan="8" class="text-center text-muted py-4">No records found</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.1/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        // Original JavaScript (fully preserved)
        const phone = '@Model.Phone';
        let txnData = [];

        $(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#startDate').val(today);
            $('#endDate').val(today);

            const start = $('#startDate').val();
            const end = $('#endDate').val();

            loadPassbook(start, end);

            $('#btnLoad').click(function () {
                const start1 = $('#startDate').val();
                const end1 = $('#endDate').val();
                loadPassbook(start1, end1);
            });

            $('#btnExport').click(function () {
                exportToExcel(txnData);
            });
        });

        function loadPassbook(start, end) {
            $('#txnBody').html('<tr><td colspan="8" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading...</span></div></td></tr>');
        $.get(`https://paymanfintech.in/PayOut/GetPassbook?phone=${phone}&startDate=${start}&endDate=${end}`, function (res) {
                if (!res.transactions || res.transactions.length === 0) {
                    $('#txnBody').html('<tr><td colspan="8" class="text-center text-muted py-4">No records found</td></tr>');
                    return;
                }

                txnData = res.transactions;

                // Set user data
                $('#userName').text(res.user.name);
                $('#userPhone').text(res.user.phone);
                $('#userEmail').text(res.user.email);
                $('#userInitial').text(res.user.name ? res.user.name.charAt(0).toUpperCase() : 'U');
                $('#userCard').show();

                // Totals
                $('#totalPaid').text('₹' + res.totalPaid.toLocaleString());
                $('#totalReceived').text('₹' + res.totalReceived.toLocaleString());
                $('#totalPaidCount').text(res.totalPaidCount);
                $('#totalReceivedCount').text(res.totalReceivedCount);
                $('#summaryRow').show();

                // Transactions
                let rows = '';
                res.transactions.forEach(txn => {
                    const type = txn.isCredit ? "Credit" : "Debit";
                    const badgeClass = txn.isCredit ? "badge-credit" : "badge-debit";
                    const amountClass = txn.isCredit ? "amount-credit" : "amount-debit";

                    rows += `
                        <tr>
                            <td>${formatISTManually(txn.dateTime)}</td>
                            <td class="${amountClass}">₹${txn.amount}</td>
                            <td><span class="${badgeClass}">${type}</span></td>
                            <td>${txn.tag || '-'}</td>
                            <td>${txn.details || '-'}</td>
                            <td>${txn.upiRef || '-'}</td>
                            <td>${txn.availableBalance || '-'}</td>
                            <td>${txn.status || '-'}</td>
                        </tr>`;
                });
                $('#txnBody').html(rows);
            });
        }

        function formatISTManually(dateStr) {
            if (!dateStr || dateStr === "NA") return "NA";
            const cleanStr = dateStr.endsWith('Z') ? dateStr.slice(0, -1) : dateStr;
            const [datePart, timePart] = cleanStr.split('T');
            const [year, month, day] = datePart.split('-');
            let [hours, minutes, seconds] = timePart.split(':');
            hours = parseInt(hours, 10);
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            if (hours === 0) hours = 12;
            const hoursStr = String(hours).padStart(2, '0');
            return `${day}/${month}/${year} ${hoursStr}:${minutes} ${ampm}`;
        }

        function exportToExcel(data) {
            if (data.length === 0) return;
            const sheetData = data.map(t => ({
                Date: moment(t.dateTime).format("DD/MM/YYYY hh:mm A"),
                Amount: t.amount,
                Type: t.isCredit ? "Credit" : "Debit",
                Mode: t.mode || "",
                Description: t.description || ""
            }));
            const ws = XLSX.utils.json_to_sheet(sheetData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Passbook");
            XLSX.writeFile(wb, "Passbook.xlsx");
        }
    </script>
}
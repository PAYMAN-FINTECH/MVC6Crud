         function renderRecentPayments(payments) {
             let html = '';
             payments.forEach(p => {
                 const statusClass = p.status === true ? 'badge-success' : 'badge-danger';
                 html += `
                    <tr>
                        <td>${formatDate(p.created)}</td>

        function startLayerCheckout(paymentToken, accessKey, payload) {
            const cardNumber1 = payload.card;
            const cardHolderName1 = payload.name;
            const cardHolderNumber1 = payload.mobile;

            Layer.checkout({
                token: paymentToken,
                accesskey: accessKey,
                theme: {
                    logo: "https://paymanfintech.in/images/Finalicon.png",
                    color: "#4787ed",
                    error_color: "#ff2b2b"
                },
                prefill: {
                    name: cardHolderName1,
                    email: payload.email,
                    contact: cardHolderNumber1
                }
            },
            function (response) {
                if (response.status === "captured") {
                    window.location.href = "/OpenMoneyPayment/CheckStatus?paymentId=" +
                        response.payment_id +
                        "&paymentTokenId=" + response.payment_token_id +
                        "&cardNumber=" + cardNumber1 +
                        "&cardHolderName=" + encodeURIComponent(cardHolderName1) +
                        "&cardHolderNumber=" + cardHolderNumber1;
                } else if (response.status === "failed") {
                    window.location.href = "/OpenMoneyPayment/Failure";
                } else if (response.status === "cancelled") {
                    window.location.href = "/OpenMoneyPayment/Cancelled";
                } else {
                    console.log("Unhandled status:", response.status, response);
                }
            },
            function (err) {
                console.error("Layer integration error:", err);
                alert("Something went wrong. Please try again.");
            });
        }


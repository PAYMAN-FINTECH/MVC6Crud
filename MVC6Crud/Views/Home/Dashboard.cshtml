@model MVC6Crud.Models.PaymanWeb.DashboardViewModelWeb
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/dashboard1.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

<div class="dashboard-container">
    @*   @if (Model.CustomerType != "new")
    {
        <div class="scrolling-note">
            <span>Payout will work 6AM to 11PM</span>
        </div>
    } *@

    <!-- Profile Section -->
    <div class="main-section">
        <div class="profile-container glass-card">
            <div class="profile-section">
                <div class="profile-image-container">
                    <img src="@Model.ProfileImageUrl" class="profile-image" alt="Profile" />
                </div>
                <div class="profile-content">
                    <div class="profile-header">
                        <h2>
                            Profile
                            @if (Model.IsAdmin == true)
                            {
                                <a asp-area="" asp-controller="Home" asp-action="AdminDashboard" class="admin-icon">
                                    <i class="bi bi-person-gear"></i>
                                </a>
                            }
                        </h2>
                        <div class="header-actions">
                            <div class="payment-options">
                                @foreach (var toggle in Model.PaymentToggles)
                                {
                                    <label class="payment-toggle">
                                        <input type="checkbox"
                                               class="toggle-checkbox"
                                               data-label="@toggle.Label"
                                               @(toggle.IsChecked ? "checked" : "") />
                                        <span class="slider"></span>
                                        <span class="toggle-label">@toggle.Label</span>
                                    </label>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="profile-details">
                        <div class="detail-row">
                            <span class="detail-label">Name:</span>
                            <span class="detail-value">@Model.UserName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Phone:</span>
                            <span class="detail-value">@Model.UserPhone</span>
                        </div>
                    </div>

                    <div class="balance-cards">
                        @foreach (var card in Model.BalanceCards)
                        {
                            <div class="balance-card @(card.IsHighlighted ? "highlight" : "")">
                                @Html.Raw(card.IconSvg)
                                <div class="balance-info">
                                    <span class="balance-label">@card.Label</span>
                                    <span class="balance-amount">@card.Amount</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Services Grid -->
        <div class="services-modern">
            <h2 class="section-header">Our Services</h2>
            <p class="section-subtext">
                At PayMan, we deliver legendary satisfaction to our customers through seamless service.
            </p>

            <div class="service-grid-modern">
                @if (Model.CustomerType != "new")
                {
                    @if (Model.PayIn == true)
                    {
                        <div class="service-card-modern" onclick="openNewBalanceTopUpModal()">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-cash-stack service-icon"></i>
                            </div>
                            <h4>Balance TopUp</h4>
                            <p>Recharge balance instantly</p>
                        </div>
                    }
                    else
                    {
                        <div class="service-card-modern disabled" onclick="alert('Access disabled. Please contact admin.')">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-cash-stack service-icon"></i>
                            </div>
                            <h4>Balance TopUp</h4>
                            <p>Recharge balance instantly</p>
                        </div>
                    }
                }

                @if (Model.CustomerType != "new")
                {
                    @if (Model.PayOutEnable == true)
                    {
                        <a asp-area="" asp-controller="Home" asp-action="BeneficiaryList" class="text-decoration-none">
                            <div class="service-card-modern">
                                <div class="service-icon-wrapper">
                                    <i class="bi bi-credit-card-2-front service-icon"></i>
                                </div>
                                <h4>PAYMENT</h4>
                                <p>Track PayOut transactions</p>
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="service-card-modern disabled" onclick="alert('Access disabled. Please contact admin.')">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-credit-card-2-front service-icon"></i>
                            </div>
                            <h4>PAYMENT</h4>
                            <p>Track PayOut transactions</p>
                        </div>
                    }
                }

                @if (Model.CCBill == true)
                {
                    <a asp-area="" asp-controller="Home" asp-action="CreditCardBillPay" class="text-decoration-none">
                        <div class="service-card-modern">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-credit-card service-icon"></i>
                            </div>
                            <h4>Credit Card Bill Pay</h4>
                            <p>Pay CC bills on time</p>
                        </div>
                    </a>
                }
                else
                {
                    <div class="service-card-modern disabled" onclick="alert('Access disabled. Please contact admin.')">
                        <div class="service-icon-wrapper">
                            <i class="bi bi-credit-card service-icon"></i>
                        </div>
                        <h4>Credit Card Bill Pay</h4>
                        <p>Pay CC bills on time</p>
                    </div>
                }

                <a asp-area="" asp-controller="FasTag" asp-action="FastTrackPay" class="text-decoration-none">
                    <div class="service-card-modern">
                        <div class="service-icon-wrapper">
                            <i class="bi bi-truck service-icon"></i>
                        </div>
                        <h4>Fast Tag</h4>
                        <p>Pay FastTag bills on time</p>
                    </div>
                </a>

                <a asp-area="" asp-controller="EducationFee" asp-action="EducationFeePay" class="text-decoration-none">
                    <div class="service-card-modern">
                        <div class="service-icon-wrapper">
                            <i class="bi bi-truck service-icon"></i>
                        </div>
                        <h4>Education Fee</h4>
                        <p>Education Fee on time</p>
                    </div>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="ElectricityPayBill" asp-route-billerName="Electricity" class="text-decoration-none">
                    <div class="service-card-modern">
                        <div class="service-icon-wrapper">
                            <i class="bi bi-credit-card service-icon"></i>
                        </div>
                        <h4>Electricity Bill Pay</h4>
                        <p>Pay CC bills on time</p>
                    </div>
                </a>

                <a asp-area="" asp-controller="Home" asp-action="FasTagPayBill" asp-route-billerName="Fastag" class="text-decoration-none">
                    <div class="service-card-modern">
                        <div class="service-icon-wrapper">
                            <i class="bi bi-credit-card service-icon"></i>
                        </div>
                        <h4>FasTag Bill Avenue Pay</h4>
                        <p>Pay CC bills on time</p>
                    </div>
                </a>

                <div class="service-card-modern" onclick="alert('Service Coming Soon.')">
                    <div class="service-icon-wrapper">
                        <i class="bi bi-fuel-pump service-icon"></i>
                    </div>
                    <h4>Gas Bill</h4>
                    <p>Pay your gas bills easily</p>
                </div>

                <div class="service-card-modern" onclick="alert('Service Coming Soon.')">
                    <div class="service-icon-wrapper">
                        <i class="bi bi-phone service-icon"></i>
                    </div>
                    <h4>Mobile Recharge</h4>
                    <p>Recharge your mobile instantly</p>
                </div>

                @if (Model.CustomerType != "new")
                {
                    <a asp-area="" asp-controller="Home" asp-action="PayInHistory" class="text-decoration-none">
                        <div class="service-card-modern">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-arrow-down-circle service-icon"></i>
                            </div>
                            <h4>My PayIns</h4>
                            <p>PayIn bills on time</p>
                        </div>
                    </a>

                    <a asp-area="" asp-controller="Home" asp-action="PayOutHistory" class="text-decoration-none">
                        <div class="service-card-modern">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-arrow-up-circle service-icon"></i>
                            </div>
                            <h4>My PayOuts</h4>
                            <p>PayOut bills on time</p>
                        </div>
                    </a>

                    <a asp-area="" asp-controller="Home" asp-action="Passbook" class="text-decoration-none">
                        <div class="service-card-modern">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-journal-text service-icon"></i>
                            </div>
                            <h4>PassBook</h4>
                            <p>Passbook bills on time</p>
                        </div>
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="PayOutHistory" class="text-decoration-none">
                        <div class="service-card-modern">
                            <div class="service-icon-wrapper">
                                <i class="bi bi-arrow-up-circle service-icon"></i>
                            </div>
                            <h4>Transaction History</h4>
                            <p>bills on time</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- ========== NEW ENHANCED BALANCE TOPUP MODAL ========== -->
    <!-- ========== NEW ENHANCED BALANCE TOPUP MODAL ========== -->
    <div class="modal fade" id="balanceTopUpModalNew" tabindex="-1" aria-labelledby="topupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <form id="topUpFormNew" novalidate>
                    <div class="modal-header">
                        <h5 class="modal-title">Balance TopUp</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <!-- Three-column input fields -->
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="fullName" placeholder="Enter full name" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" placeholder="Enter email" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Mobile Number</label>
                                <input type="text" class="form-control" id="mobileNumber" maxlength="10" placeholder="10-digit mobile" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Credit Card</label>
                                <input type="text" class="form-control" id="customerCardNew" maxlength="16" placeholder="Enter card number" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount</label>
                                <input type="number" class="form-control" id="amountNew" min="1" placeholder="Enter amount" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Gateway</label>
                                <select class="form-select" id="gatewayNew" required>
                                    <option value="">-- Select Gateway --</option>
                                    <!-- Options populated by API -->
                                </select>
                            </div>
                        </div>

                        <!-- Validation Error -->
                        <div id="formErrorNew" class="alert alert-warning mt-2" style="display:none;"></div>

                        <!-- Action Buttons (Pay & Cancel) -->
                        <div class="d-flex gap-2 justify-content-end mt-4">
                            <button type="submit" id="payButtonNew" class="btn btn-primary px-5" disabled>Pay</button>
                            <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                        </div>

                        <!-- Recent Payments Section (enhanced UI) -->
                        <div class="recent-payments-section mt-4" id="recentPaymentsSection" style="display:none;">
                            <hr class="my-4" />
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-navy mb-0">Recent Payments</h6>
                                <div class="search-wrapper" style="width: 250px;">
                                    <i class="bi bi-search search-icon-small"></i>
                                    <input type="text" class="form-control form-control-sm" id="paymentSearch" placeholder="Search by name..." />
                                </div>
                            </div>
                            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Amount</th>
                                            <th>Card</th>
                                            <th>Name</th>
                                            <th>Mobile</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody id="recentPaymentsBody">
                                        <tr><td colspan="6" class="text-center text-muted py-4">No recent payments</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Balance TopUp Modal -->
    <div class="modal fade" id="balanceTopUpModal" tabindex="-1" aria-labelledby="topupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form id="topUpForm" novalidate>
                    <div class="modal-header">
                        <h5 class="modal-title">Balance TopUp</h5>
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addProfileModal">
                                + Add Profile
                            </button>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                    </div>

                    <div class="modal-body">
                        <div class="col-12 mb-4">
                            <label class="form-label">Customer Mobile</label>
                            <input type="text" class="form-control" id="customerMobile" maxlength="10" required placeholder="Enter customer mobile">
                            <div class="invalid-feedback">Mobile number is required.</div>
                        </div>

                        <div class="row g-4">
                            <!-- Profile Card -->
                            <div class="col-12 col-md-5">
                                <div class="card profile-card h-100" id="profileSection" style="display:none;">
                                    <div class="card-body">
                                        <h6 class="card-title">Profile Details</h6>
                                        <p><i class="bi bi-person-fill me-2"></i> <strong>Name:</strong> <span id="profileName"></span></p>
                                        <p><i class="bi bi-telephone-fill me-2"></i> <strong>Mobile:</strong> <span id="profileMobile"></span></p>
                                        <p><i class="bi bi-envelope-fill me-2"></i> <strong>Email:</strong> <span id="profileEmail"></span></p>
                                    </div>
                                </div>
                                <div id="profileError" class="alert alert-danger mt-2" style="display:none;"></div>
                            </div>

                            <!-- Payment Card -->
                            <div class="col-12 col-md-7">
                                <div class="card payment-card h-100" id="paymentSection" style="display:none;">
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label class="form-label">Credit Card</label>
                                            <div class="input-group">
                                                <select class="form-select" id="customerCardSelect" required></select>
                                                <button type="button" class="btn btn-outline-primary" id="addCardBtn">Add</button>
                                            </div>
                                            <input type="text" class="form-control mt-2 d-none" id="customerCardInput" maxlength="16" placeholder="Enter new card">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Amount</label>
                                            <input type="number" class="form-control" id="amount" min="1" required disabled placeholder="Enter amount">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Gateway</label>
                                            <select class="form-select" id="gateway" required disabled>
                                                <option value="">-- Select Gateway --</option>
                                                @if (((Model.Easebuzz1 == true || Model.Easebuzz2 == true) && Model.UserEasebuzz == true) || Model.IsAdmin == true)
                                                {
                                                    <option value="1">Easebuzz</option>
                                                }
                                                @if (Model.IsAdmin || (Model.EduCashfree == true && Model.EduGateway == true))
                                                {
                                                    <option value="4">Travel PG</option>
                                                }
                                                @if (Model.IsAdmin == true || (Model.OpenMoney == true && Model.RozorpayEdu == true))
                                                {
                                                    <option value="6">JioPay Edu</option>
                                                }
                                            </select>
                                        </div>
                                        <div id="formError" class="alert alert-warning mt-2" style="display:none;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" id="payButton" class="btn btn-primary" disabled>Pay</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Profile Modal -->
    <div class="modal fade" id="addProfileModal" tabindex="-1" aria-labelledby="addProfileLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="addProfileForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addProfileLabel">Add Profile</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="newProfileMobile" class="form-label">Mobile</label>
                            <input type="text" class="form-control" id="newProfileMobile" maxlength="10" required />
                        </div>
                        <div class="mb-3">
                            <label for="newProfileName" class="form-label">Name</label>
                            <input type="text" class="form-control" id="newProfileName" required />
                        </div>
                        <div class="mb-3">
                            <label for="newProfileEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="newProfileEmail" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="saveProfileBtn" class="btn btn-success">Save</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Global Loader -->
    <div id="Loader1" class="global-loader" style="display:none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Success Message Toast -->
    <div id="successMessage" class="alert alert-success toast-message" style="display:none;">
        Toggle updated successfully!
    </div>
</div>



@section Scripts {
    <!-- Paytm Script -->
    <script src="https://secure.paytmpayments.com/merchantpgpui/checkoutjs/merchants/TvEYNH13757085326682.js"></script>


    <script id="context" type="text/javascript" src="https://payments.open.money/layer"></script>
    <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>
    <script>
        // Your original JavaScript remains exactly the same – untouched.
        function startKYC() {
            fetch('/DigiLocker/StartDigiLocker', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    verificationId: 'ABC00123kkk',
                    redirectUrl: 'https://localhost:44384/DigiLocker/Callback',
                    documents: ['AADHAAR', 'PAN']
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.url) window.location.href = data.url;
                else alert('Failed to initiate KYC process.');
            })
            .catch(error => {
                console.error('Error initiating KYC:', error);
                alert('An error occurred. Please try again later.');
            });
        }

        function openBalanceTopUpModal() {
            const modalEl = document.getElementById('balanceTopUpModal');
            const form = document.getElementById('topUpForm');
            form.reset();
            form.classList.remove('was-validated');
            $('#customerMobile').val('');
            $("#profileSection, #paymentSection").hide();
            $("#formError").hide();
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

        $(document).ready(function () {
            $('#Loader1').hide(); // ensure loader starts hidden
            var loginUser = '@Model.UserPhone';

            $('.toggle-checkbox').change(function () {
                var isChecked = $(this).is(':checked');
                var label = $(this).data('label');
                $.ajax({
                    url: '/Auth/UpdateToggle',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ label: label, isChecked: isChecked }),
                    success: function () {
                        $('#successMessage').fadeIn(300).delay(1500).fadeOut(300);
                    },
                    error: function () {
                        alert("Failed to update toggle.");
                    }
                });
            });

            let profileLoaded = false;

            $("#customerMobile").on("input", function () {
                let mobile = $(this).val().trim();
                if (/^\d{10}$/.test(mobile)) fetchProfile(mobile);
                else resetProfile();
            });

            $("#addCardBtn").on("click", function () {
                $("#customerCardSelect").addClass("d-none");
                $("#customerCardInput").removeClass("d-none").prop("disabled", false).val("").focus();
                $(this).addClass("d-none");
                validateForm();
            });

            $("#customerCardSelect, #customerCardInput, #amount, #gateway").on("input change blur", validateForm);

            function fetchProfile(mobile) {
                $.ajax({
                    url: "/Home/GetCustomerDetails",
                    type: "GET",
                    data: { mobileNumber: mobile, loginuserphone: loginUser },
                    beforeSend: function () {
                        $("#profileError").hide();
                        $("#profileSection, #paymentSection").hide();
                    },
                    success: function (res) {
                        if (res.success && res.data.length > 0) {
                            const profile = res.data[0];
                            $("#profileName").text(profile.cardHolderName);
                            $("#profileMobile").text(mobile);
                            $("#profileEmail").text(profile.cardHolderEmail);

                            let select = $("#customerCardSelect");
                            select.empty().append(`<option value="">-- Select Card --</option>`);
                            res.data.forEach(c => {
                                if (c.creditCardNum != null) {
                                    select.append(`<option value="${c.creditCardNum}">${c.creditCardNum}</option>`);
                                }
                            });
                            $("#customerCardSelect").val("");
                            $("#profileSection, #paymentSection").show();
                            $("#customerCardSelect").removeClass("d-none").prop("disabled", false);
                            $("#customerCardInput").addClass("d-none").prop("disabled", true);
                            $("#amount, #gateway").prop("disabled", false);
                            profileLoaded = true;
                            validateForm();
                        } else {
                            resetProfile(res.message || "Profile not found");
                        }
                    },
                    error: function () {
                        resetProfile("Error fetching profile");
                    }
                });
            }

            function resetProfile(msg = "") {
                profileLoaded = false;
                $("#profileSection, #paymentSection").hide();
                $("#customerCardSelect, #customerCardInput, #amount, #gateway").prop("disabled", true);
                $("#customerCardSelect").removeClass("d-none");
                $("#customerCardInput").addClass("d-none").val("");
                $("#payButton").prop("disabled", true);
                $("#formError").hide();
                if (msg) $("#profileError").text(msg).show();
            }

            function validateForm() {
                const cardVal = $("#customerCardInput").is(":visible")
                    ? $("#customerCardInput").val().trim()
                    : $("#customerCardSelect").val();
                const amountVal = parseFloat($("#amount").val());
                const gatewayVal = $("#gateway").val();

                let isValid = true;
                let message = "";

                if (!cardVal || !/^\d{12,16}$/.test(cardVal)) {
                    isValid = false;
                    message = "Please enter a valid 12–16 digit card number.";
                } else if (isNaN(amountVal) || amountVal <= 0) {
                    isValid = false;
                    message = "Please enter a valid amount greater than 0.";
                } else if (amountVal > 99999) {
                    isValid = false;
                    message = "Amount cannot exceed 99,999.";
                } else if (!gatewayVal) {
                    isValid = false;
                    message = "Please select a payment gateway.";
                } else if (!profileLoaded) {
                    isValid = false;
                    message = "Please load a valid profile by entering a 10-digit mobile number.";
                } else if (gatewayVal == 4 && amountVal > 99999) {
                    isValid = false;
                    message = "Amount cannot exceed 99,999 for Travel PG.";
                }

                $("#payButton").prop("disabled", !isValid);
                if (!isValid && message) {
                    $("#formError").text(message).show();
                } else {
                    $("#formError").hide();
                }
            }

            function isValidEmail(email) {
                var regex = /^[^\s]+[^\s]+\.[^\s]+$/;
                return regex.test(email);
            }

            $("#saveProfileBtn").click(function () {
                var profile = {
                    Mobile: $("#newProfileMobile").val(),
                    Name: $("#newProfileName").val(),
                    Email: $("#newProfileEmail").val(),
                    UserPhone: loginUser
                };


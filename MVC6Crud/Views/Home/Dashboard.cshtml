         function validateNewForm() {
             const name = $('#fullName').val().trim();
             const email = $('#email').val().trim();
             const mobile = $('#mobileNumber').val().trim();
             const amountVal = parseFloat($('#amountNew').val());
             const gatewayVal = $('#gatewayNew').val();
             const cardVal = $('#customerCardNew').val().trim();
             let isValid = true;
             let message = "";
             if (!name) {
                 isValid = false;
                 message = "Please enter full name.";
             } else if (!email || !/^[^\s]+[^\s]+\.[^\s]+$/.test(email)) {
                 isValid = false;
                 message = "Please enter a valid email.";
             } else if (!mobile || !/^\d{10}$/.test(mobile)) {
                 isValid = false;
                 message = "Please enter a valid 10-digit mobile number.";
             } else if (!cardVal || !/^\d{12,16}$/.test(cardVal)) {
                 isValid = false;
                 message = "Please enter a valid 12–16 digit card number.";
             } else if (isNaN(amountVal) || amountVal <= 0) {
                 isValid = false;
                 message = "Please enter a valid amount greater than 0.";
                 } else if (amountVal > 49999 && gatewayVal == "CoreVegaah") {
                 isValid = false;
                 message = "Amount cannot exceed 99,999.";
                 } else if (amountVal > 70000 && gatewayVal != "CoreVegaah") {
                     isValid = false;
                     message = "Amount cannot exceed 99,999.";
                 }
             else if (!gatewayVal) {
                 isValid = false;
                 message = "Please select a payment gateway.";
             }
             $('#payButtonNew').prop('disabled', !isValid);
             if (!isValid && message) {
                 $('#formErrorNew').text(message).show();
             } else {
                 $('#formErrorNew').hide();
             }
         }

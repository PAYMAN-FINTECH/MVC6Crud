@using Microsoft.AspNetCore.Http
@{
    Layout = null;
    var userName = Context.Session.GetString("UserName");
    var userEmail = Context.Session.GetString("Email");
    var userPhone = Context.Session.GetString("UserPhone");
    bool isLoggedIn = !string.IsNullOrEmpty(userName);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>EDUPayman</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/Navbar2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Footer.css" asp-append-version="true" />
</head>
<body>

    @await Html.PartialAsync("_LoaderPartial")

    <nav class="navbar navbar-expand-lg navbar-dark px-3" style="background-color: #0d6efd;">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/edulogo1.png" width="40" height="40" class="me-2" alt="Payman Logo" />
                <span class="fw-bold">
                    EDU<span style="font-size: 0.6em;">payman</span>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarScroll">
                <ul class="navbar-nav align-items-center">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, @userName</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light ms-2" asp-controller="LogIn" asp-action="WebLogout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Edu" asp-action="Aboutus">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Edu" asp-action="Contact">Contact Us</a>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-light ms-3" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
                        </li>
                        <li class="nav-item ms-2">
                            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#signupModal">Signup</button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    

    @inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper HtmlHelper
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="container mt-4">
        @RenderBody()
    </div>

    
        <footer class="bg-dark pt-2 pb-3 mt-5">
            <div class="container">
                <div class="row text-white">
                    <div class="col-md-3">
                        <p class="mt-3">
                            <span class="fw-bold">EDU<span class="brand-sub">payman</span></span> offers industrial training in emerging technologies like Python, Data Science, Artificial Intelligence, and DevOps in Telugu.
                        </p>
                    </div>
                    <div class="col-md-3">
                        <h5 class="fw-bold">Follow Us</h5>
                        <div class="theme-divider2"></div>
                        <ul class="list-unstyled">
                            <li><a href="https://www.instagram.com/" target="_blank" class="text-white text-decoration-none"><i class="fa-brands fa-instagram me-2"></i>Instagram</a></li>
                            <li><a href="https://youtube.com/" target="_blank" class="text-white text-decoration-none"><i class="fa-brands fa-youtube me-2"></i>YouTube</a></li>
                            <li><a href="https://www.linkedin.com/" target="_blank" class="text-white text-decoration-none"><i class="fa-brands fa-linkedin me-2"></i>LinkedIn</a></li>
                            <li><a href="https://t.me/" target="_blank" class="text-white text-decoration-none"><i class="fa-brands fa-telegram me-2"></i>Telegram</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3">
                        <h5 class="fw-bold">Categories</h5>
                        <div class="theme-divider2"></div>
                        <ul class="list-unstyled">
                            <li><a href="#programDetails1" class="text-white text-decoration-none">Gen AI</a></li>
                            <li><a href="#programDetails2" class="text-white text-decoration-none">Cloud</a></li>
                            <li><a href="#programDetails3" class="text-white text-decoration-none">Drone & Robotics</a></li>
                            <li><a href="#programDetails4" class="text-white text-decoration-none">DevOps</a></li>
                            <li><a href="#programDetails5" class="text-white text-decoration-none">Electric Vehicle</a></li>
                            <li><a href="#programDetails6" class="text-white text-decoration-none">Data Engineer</a></li>
                            <li><a href="#programDetails7" class="text-white text-decoration-none">Data Science and AI</a></li>
                        </ul>
                    </div>
                    <div class="col-md-3">
                        <h5 class="fw-bold">Quick Links</h5>
                        <div class="theme-divider2"></div>
                        <ul class="list-unstyled">
                            <li><a asp-action="Index" asp-controller="Edu" class="text-white text-decoration-none">Home</a></li>
                            <li><a asp-action="Aboutus" asp-controller="Edu" class="text-white text-decoration-none">About Us</a></li>
                            <li><a asp-action="Refound" asp-controller="Edu" class="text-white text-decoration-none">Refund and Cancellation Policy</a></li>
                            <li><a asp-action="Contact" asp-controller="Edu" class="text-white text-decoration-none">Contact Us</a></li>
                            <li><a asp-action="Privacy" asp-controller="Edu" class="text-white text-decoration-none">Privacy</a></li>
                            <li><a asp-action="termsandconditions" asp-controller="Edu" class="text-white text-decoration-none">Terms and Conditions</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

   

   

    <!-- ================= LOGIN MODAL ================= -->
    <div class="modal fade" id="loginModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" id="loginPhone" class="form-control mb-2" required placeholder="Email or Phone" />
                    <input type="password" id="loginPin" class="form-control mb-2" required placeholder="Password" />
                    <div id="loginError" class="text-danger"></div>
                    @* <a href="#" onclick="openForgotPasswordModal()"><small>Forgot Password?</small></a> *@
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" onclick="submitLogin()">Login</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SIGNUP MODAL ================= -->
    <div class="modal fade" id="signupModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3">
                <h5>Signup</h5>
                <input type="text" id="signupName" class="form-control mb-2" required placeholder="Full Name">
                <input type="text" id="signupPhone" class="form-control mb-2" required placeholder="Phone">
                <input type="email" id="signupEmail" class="form-control mb-2" required placeholder="Email">
                <input type="password" id="signupPassword" class="form-control mb-2" placeholder="Password">
                <div id="signupError" class="text-danger"></div>
                <button class="btn btn-success" onclick="submitSignup()">Create Account</button>
            </div>
        </div>
    </div>

    <!-- ================= FORGOT PASSWORD MODAL ================= -->
    <div class="modal fade" id="forgotPasswordModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-3">
                <small>Forgot Password</small>
                <input type="text" id="forgotMobile" class="form-control mb-2" placeholder="Registered Email">
                <div id="forgotError" class="text-danger small"></div>
                <button class="btn btn-primary" onclick="submitForgotPassword()">Send OTP</button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast text-white bg-danger">
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function submitLogin(){
            $('#Loader1').show();
                var phone = $('#loginPhone').val();
        var pin = $('#loginPin').val();

        if (!phone || !pin) {
            $('#loginError').text("Please enter both fields.");
               $('#Loader1').hide();
            return;
        }

            $.ajax({
                url: '/Insurance/Login',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    mobile: $('#loginPhone').val(),
                    password: $('#loginPin').val()
                }),
                success: function(res){
                    if(res.isSuccess){
                        location.reload();   // stay on same page after login
                    }else{
                        $('#loginError').text("Invalid login");
                    }
                    $('#Loader1').hide();
                },
                error: function(){
                    $('#loginError').text("Server error");
                    $('#Loader1').hide();
                }
            });
        }

        function submitSignup(){
             $('#Loader1').show();

               var signupName = $('#signupName').val();
               var signupPhone = $('#signupPhone').val();
               var signupEmail = $('#signupEmail').val();
               var signupPassword = $('#signupPassword').val();

        if (!signupPhone || !signupName || !signupPassword || !signupEmail) {
            $('#signupError').text("Please enter both fields.");
               $('#Loader1').hide();
            return;
        }

        // ✅ Email regex validation
    var emailRegex = /^[^\s]+[^\s]+\.[^\s]+$/;

    if (!emailRegex.test(signupEmail)) {
        $('#signupError').text("Please enter a valid email address.");
        $('#Loader1').hide();
        return;
    }

            $.ajax({
                url: '/Insurance/Register',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    name: $('#signupName').val(),
                    mobile: $('#signupPhone').val(),
                    email: $('#signupEmail').val(),
                    password: $('#signupPassword').val()
                }),
                success: function(res){
                    $('#Loader1').hide();
                    if(res.isSuccess){
                        alert("Signup successful. Please login.");
                        $('#signupModal').modal('hide');
                        $('#loginModal').modal('show');
                    }else{
                        $('#signupError').text(res.message);
                    }
                }
            });
        }

        function openForgotPasswordModal(){
            $('#loginModal').modal('hide');
            $('#forgotPasswordModal').modal('show');
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Insurance Premium Payments by Payman</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/insurence.css" />
</head>
<body>

    <!-- ================= GLOBAL LOADER ================= -->
    <div id="globalLoader" class="loader-overlay d-none">
        <div class="loader-box">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 fw-semibold">Processing, please wait...</p>
        </div>
    </div>
    <!-- ================================================= -->

    <nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index"> <i class="fas fa-shield-alt me-2"></i>Insurance by PayMan </a> <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"> <span class="navbar-toggler-icon"></span> </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item about-us-item4"> <a class="nav-link active" asp-controller="Insurance" asp-action="Index">Home</a> </li>
                    <li class="nav-item about-us-item"> <a class="nav-link" asp-controller="Insurance" asp-action="AboutUs">About Us</a> </li>
                    @* 
            <li class="nav-item about-us-item1"> <a class="nav-link" href="#">How It Works</a> </li>
            <li class="nav-item about-us-item2"> <a class="nav-link" href="#">FAQs</a> </li>
            *@ 
            <li class="nav-item about-us-item3"> <a class="nav-link" asp-controller="Insurance" asp-action="ContactUs">Contact</a> </li>
                    <li class="nav-item"> <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#signupModal">Sign Up</a> </li>
                    <li class="nav-item ms-2"> <button type="button" class="btn btn-primary px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#loginModal"> <i class="fas fa-credit-card me-2"></i>Pay Premium </button> </li>
                </ul>
            </div>
        </div>
    </nav>
    @inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper HtmlHelper
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div class="main-content">
        @RenderBody()
    </div>

    @if (currentController == "Insurance" && currentAction == "Index")
    {
        @await Html.PartialAsync("_insurenceFooter")
    }

    <!-- jQuery (FIRST) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/insurence.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
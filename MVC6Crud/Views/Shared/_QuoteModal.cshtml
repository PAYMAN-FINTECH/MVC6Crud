@{
    // This partial view is loaded into the modal when "Get A Quote" is clicked
}

<!-- Container for step content (will be filled by JavaScript) -->
<div id="bookingStepContainer"></div>

<script>
    (function() {
        // Complete list of Telangana districts
        const telanganaDistricts = [
            "Adilabad", "Bhadradri Kothagudem", "Hanamkonda", "Hyderabad", "Jagitial",
            "Jangaon", "Jayashankar Bhupalpally", "Jogulamba Gadwal", "Kamareddy",
            "Karimnagar", "Khammam", "Kumuram Bheem", "Mahabubabad", "Mahabubnagar",
            "Mancherial", "Medak", "Medchal–Malkajgiri", "Mulugu", "Nagarkurnool",
            "Nalgonda", "Narayanpet", "Nirmal", "Nizamabad", "Peddapalli", "Rajanna Sircilla",
            "Rangareddy", "Sangareddy", "Siddipet", "Suryapet", "Vikarabad", "Wanaparthy",
            "Warangal", "Yadadri Bhuvanagiri"
        ];

        // Helper: generate random bus numbers (5-10)
        function generateRandomBuses() {
            const count = Math.floor(Math.random() * 6) + 5;
            const buses = [];
            const prefixes = ["TS", "HYD", "WGL", "KMM", "NZB", "KNR", "MDCL", "RNR", "ADB", "NLM"];
            for (let i = 0; i < count; i++) {
                const prefix = prefixes[Math.floor(Math.random() * prefixes.length)];
                const number = Math.floor(Math.random() * 9000 + 1000);
                buses.push(`${prefix}-${number}`);
            }
            return buses;
        }

        // Helper: random amount between 300 and 800
        function randomAmount() {
            return Math.floor(Math.random() * 500 + 300);
        }

        // State
        let currentStep = 1;
        let pickupDistrict = '';
        let dropoffDistrict = '';
        let travelDate = '';
        let travelTime = '';
        let availableBuses = [];
        let selectedBus = '';
        let amount = 0;
        let bookingData = { name: '', mobile: '', email: '' };

        const container = document.getElementById('modalContent'); // target for step HTML

        function closeModal() {
            const modal = document.getElementById('quoteModal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // ---------- Step 1: Pickup, Dropoff, Date, Time ----------
        function renderStep1() {
            const districtOptions = telanganaDistricts.map(d => `<option value="${d}">${d}</option>`).join('');
            const today = new Date().toISOString().split('T')[0];

            const html = `
                <div class="p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-2xl font-bold text-[#0a2942]">Plan Your Journey</h2>
                        <button type="button" class="close-modal text-gray-400 hover:text-gray-600 transition">
                            <i class="fas fa-times text-2xl"></i>
                        </button>
                    </div>
                    <form id="searchForm" class="space-y-4">
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Pickup District <span class="text-red-500">*</span></label>
                                <select id="pickupSelect" required class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition bg-white">
                                    <option value="">Select pickup</option>
                                    ${districtOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Dropoff District <span class="text-red-500">*</span></label>
                                <select id="dropoffSelect" required class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition bg-white">
                                    <option value="">Select dropoff</option>
                                    ${districtOptions}
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Travel Date <span class="text-red-500">*</span></label>
                                <input type="date" id="dateInput" min="${today}" required class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Travel Time <span class="text-red-500">*</span></label>
                                <select id="timeSelect" required class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition bg-white">
                                    <option value="">Select time</option>
                                    <option value="07:20">07:20</option>
                                    <option value="08:40">08:40</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:21">10:21</option>
                                    <option value="16:30">16:30</option>
                                    <option value="18:45">18:45</option>
                                </select>
                            </div>
                        </div>
                        <div class="flex justify-end mt-6">
                            <button type="submit" class="bg-[#1f3a5f] text-white px-6 py-2 rounded-full font-semibold hover:bg-[#123256] transition">
                                Search Buses <i class="fas fa-search ml-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            `;

            container.innerHTML = html;

            // Set previous values if any
            if (pickupDistrict) document.getElementById('pickupSelect').value = pickupDistrict;
            if (dropoffDistrict) document.getElementById('dropoffSelect').value = dropoffDistrict;
            if (travelDate) document.getElementById('dateInput').value = travelDate;
            if (travelTime) document.getElementById('timeSelect').value = travelTime;

            // Close buttons
            document.querySelectorAll('.close-modal').forEach(btn => btn.addEventListener('click', closeModal));

            // Handle form submit
            document.getElementById('searchForm').addEventListener('submit', function(e) {
                e.preventDefault();
                pickupDistrict = document.getElementById('pickupSelect').value;
                dropoffDistrict = document.getElementById('dropoffSelect').value;
                travelDate = document.getElementById('dateInput').value;
                travelTime = document.getElementById('timeSelect').value;

                if (!pickupDistrict || !dropoffDistrict || !travelDate || !travelTime) {
                    alert('Please fill all fields');
                    return;
                }
                if (pickupDistrict === dropoffDistrict) {
                    alert('Pickup and dropoff districts cannot be the same');
                    return;
                }

                availableBuses = generateRandomBuses();
                currentStep = 2;
                renderStep2();
            });
        }

        // ---------- Step 2: Bus Selection ----------
        function renderStep2() {
            const busesHtml = availableBuses.map(bus => `
                <button class="bus-option p-4 rounded-xl border border-gray-200 hover:border-[#1f4a7a] hover:bg-[#f0f7ff] transition-all text-left ${selectedBus === bus ? 'bg-[#1f4a7a] text-white border-[#1f4a7a]' : 'bg-white'}"
                        data-bus="${bus}">
                    <div class="font-bold text-lg">${bus}</div>
                    <div class="text-xs opacity-75">AC Sleeper • 40 seats</div>
                    <div class="text-sm mt-1">Fare: ₹${randomAmount()}</div>
                </button>
            `).join('');

            const html = `
                <div class="p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-2xl font-bold text-[#0a2942]">Available Buses</h2>
                        <button type="button" class="close-modal text-gray-400 hover:text-gray-600 transition">
                            <i class="fas fa-times text-2xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 mb-2">${pickupDistrict} → ${dropoffDistrict}</p>
                    <p class="text-gray-600 mb-4">${travelDate} at ${travelTime}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto p-1">
                        ${busesHtml}
                    </div>
                    <div class="flex justify-between mt-6">
                        <button type="button" id="backToSearchBtn" class="border border-gray-300 text-gray-700 px-6 py-2 rounded-full hover:bg-gray-50 transition">
                            <i class="fas fa-arrow-left mr-2"></i> Back
                        </button>
                        <button type="button" id="nextToDetailsBtn" class="bg-[#1f3a5f] text-white px-6 py-2 rounded-full font-semibold hover:bg-[#123256] transition ${!selectedBus ? 'opacity-50 cursor-not-allowed' : ''}" ${!selectedBus ? 'disabled' : ''}>
                            Next: Your Details <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </div>
            `;

            container.innerHTML = html;

            // Bus selection
            document.querySelectorAll('.bus-option').forEach(btn => {
                btn.addEventListener('click', function() {
                    selectedBus = this.dataset.bus;
                    const fareText = this.querySelector('.text-sm.mt-1').innerText;
                    amount = parseInt(fareText.replace('Fare: ₹', ''));
                    renderStep2(); // re-render to update selected state
                });
            });

            document.querySelectorAll('.close-modal').forEach(btn => btn.addEventListener('click', closeModal));

            document.getElementById('backToSearchBtn').addEventListener('click', () => {
                currentStep = 1;
                renderStep1();
            });

            const nextBtn = document.getElementById('nextToDetailsBtn');
            if (nextBtn && selectedBus) {
                nextBtn.disabled = false;
                nextBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                nextBtn.addEventListener('click', () => {
                    currentStep = 3;
                    renderStep3();
                });
            }
        }

        // ---------- Step 3: Personal Details ----------
        function renderStep3() {
            const html = `
                <div class="p-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-2xl font-bold text-[#0a2942]">Your Details</h2>
                        <button type="button" class="close-modal text-gray-400 hover:text-gray-600 transition">
                            <i class="fas fa-times text-2xl"></i>
                        </button>
                    </div>
                    <p class="text-gray-600 mb-2">Route: <span class="font-semibold text-[#1f4a7a]">${pickupDistrict} → ${dropoffDistrict}</span></p>
                    <p class="text-gray-600 mb-2">Bus: <span class="font-semibold text-[#1f4a7a]">${selectedBus}</span></p>
                    <p class="text-gray-600 mb-4">Amount: <span class="font-semibold text-[#1f4a7a]">₹${amount}</span></p>

                    <form id="detailsForm" class="space-y-4">
                        <!-- Anti‑forgery token (if needed) -->
                        <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}">

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
                            <input type="text" name="Name" required value="${bookingData.name}"
                                   class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition"
                                   placeholder="Your full name">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Mobile Number <span class="text-red-500">*</span></label>
                            <input type="tel" name="Mobile" required pattern="[0-9]{10}" maxlength="10" value="${bookingData.mobile}"
                                   class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition"
                                   placeholder="10 digit mobile number">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                            <input type="email" name="Email" required value="${bookingData.email}"
                                   class="w-full px-3 py-2 text-sm rounded-xl border border-gray-200 focus:border-[#1f4a7a] focus:ring-1 focus:ring-[#1f4a7a] outline-none transition"
                                   placeholder="your@email.com">
                        </div>

                        <div class="flex justify-between items-center mt-6">
                            <button type="button" id="backToBusesBtn" class="border border-gray-300 text-gray-700 px-6 py-2 rounded-full hover:bg-gray-50 transition">
                                <i class="fas fa-arrow-left mr-2"></i> Back
                            </button>
                            <button type="submit" class="bg-[#1f3a5f] text-white px-6 py-2 rounded-full font-semibold hover:bg-[#123256] transition">
                                Confirm Booking <i class="fas fa-check-circle ml-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            `;

            container.innerHTML = html;

            document.querySelectorAll('.close-modal').forEach(btn => btn.addEventListener('click', closeModal));

            document.getElementById('backToBusesBtn').addEventListener('click', () => {
                currentStep = 2;
                renderStep2();
            });

            document.getElementById('detailsForm').addEventListener('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                bookingData.name = formData.get('Name');
                bookingData.mobile = formData.get('Mobile');
                bookingData.email = formData.get('Email');

                if (!bookingData.name || !bookingData.mobile || !bookingData.email) {
                    alert('Please fill all fields');
                    return;
                }
                if (!/^\d{10}$/.test(bookingData.mobile)) {
                    alert('Please enter a valid 10-digit mobile number');
                    return;
                }

                currentStep = 4;
                renderStep4();
            });
        }

        // ---------- Step 4: Success ----------
        function renderStep4() {
            const bookingId = 'TXN' + Math.floor(Math.random() * 1000000);

            const html = `
                <div class="p-6 text-center">
                    <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center text-3xl text-green-600 mx-auto mb-4">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-[#0a2942] mb-2">Booking Confirmed!</h2>
                    <p class="text-lg text-gray-600 mb-4">Thank you, <span class="font-semibold text-[#1f4a7a]">${bookingData.name}</span>!</p>
                    <div class="bg-[#f0f7ff] p-4 rounded-2xl inline-block mb-4">
                        <p class="text-xl font-mono font-bold text-[#1f4a7a]">Booking ID: ${bookingId}</p>
                    </div>
                    <p class="text-lg font-semibold text-[#0a2942] mb-2">Route: <span class="text-[#1f4a7a]">${pickupDistrict} → ${dropoffDistrict}</span></p>
                    <p class="text-lg font-semibold text-[#0a2942] mb-2">Bus: <span class="text-[#1f4a7a]">${selectedBus}</span></p>
                    <p class="text-lg font-semibold text-[#0a2942] mb-2">Date & Time: <span class="text-[#1f4a7a]">${travelDate} at ${travelTime}</span></p>
                    <p class="text-lg font-semibold text-[#0a2942] mb-3">Amount Paid: <span class="text-[#1f4a7a]">₹${amount}</span></p>
                    <p class="text-gray-600 text-sm max-w-md mx-auto mb-4">We've sent the details to your email and SMS. Our team will contact you shortly to confirm.</p>
                    <div class="flex justify-center gap-3">
                        <button type="button" id="closeSuccessBtn" class="bg-[#1f3a5f] text-white px-6 py-2 rounded-full text-sm font-semibold hover:bg-[#123256] transition">Close</button>
                        <button type="button" id="bookAnotherBtn" class="border border-[#1f3a5f] text-[#1f3a5f] px-6 py-2 rounded-full text-sm font-semibold hover:bg-[#f0f7ff] transition">Book Another</button>
                    </div>
                </div>
            `;

            container.innerHTML = html;

            document.getElementById('closeSuccessBtn').addEventListener('click', closeModal);
            document.getElementById('bookAnotherBtn').addEventListener('click', () => {
                // Reset state and start over
                currentStep = 1;
                pickupDistrict = dropoffDistrict = travelDate = travelTime = '';
                availableBuses = [];
                selectedBus = '';
                amount = 0;
                bookingData = { name: '', mobile: '', email: '' };
                renderStep1();
            });
        }

        // Start the flow
        renderStep1();
    })();
</script>